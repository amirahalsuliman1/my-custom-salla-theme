# T-1.07 — editor defaults, so formatting is not a review topic.
# Values match the upstream scaffold's existing files rather than imposing new
# ones: re-indenting a shadowed upstream file would destroy the diff against the
# pinned baseline that /docs/OVERRIDES.md reconciliation depends on.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown gives meaning to trailing spaces, and the docs are deliverables.
trim_trailing_whitespace = false

[*.{twig,scss,js,mjs,json,yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab
