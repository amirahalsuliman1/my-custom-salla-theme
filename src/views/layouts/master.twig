{# ############## Shared Variables in all views ################
| Variable                                           | Type     | Description                                                                                              |
|----------------------------------------------------|----------|----------------------------------------------------------------------------------------------------------|
| store                                              | Store    |                                                                                                          |
| store.id                                           | int      |                                                                                                          |
| store.name                                         | string   |                                                                                                          |
| store.username                                     | string   |                                                                                                          |
| store.description                                  | string   |                                                                                                          |
| store.slogan                                       | ?string  | * if feature in twilight.json                                                                            |
| store.logo                                         | string   |                                                                                                          |
| store.url                                          | string   |                                                                                                          |
| store.api                                          | string   | the api url for current store                                                                            |
| store.icon                                         | string   | *fav icon url                                                                                            |
| store.contacts                                     | object   | [mobile, phone, email, whatsapp, telegram], ex. store.contacts.email                                     |
| store.social                                       | object   | [instagram, snapchat, twitter, youtube, facebook, pinterest, maroof, whatsapp], ex. store.social.twitter |
| store.settings                                     | object   |                                                                                                          |
| store.settings.auth.email_allowed                  | bool     |                                                                                                          |
| store.settings.auth.mobile_allowed                 | bool     |                                                                                                          |
| store.settings.auth.is_email_required              | bool     |                                                                                                          |
| store.settings.cart.apply_coupon_enabled           | bool     | Does visitor allowed to applay coupon in cart page                                                       |
| store.settings.product.total_sold_enabled          | bool     |                                                                                                          |
| store.settings.product.fit_type                    | ?string  | null when equal product card size is off, or ['cover', 'contain']                                        |
| store.settings.category.testimonial_enabled        | bool     | Show random testimonials in category page                                                                |
| store.settings.tax.number                          | ?string  |                                                                                                          |
| store.settings.tax.certificate                     | ?string  | certificate image url                                                                                    |
| store.settings.tax.taxable_prices_enabled          | bool     | Does tax included in the prices ex product_price 100 & tax is 15, price will be 115                      |
| store.settings.rating_enabled                      | bool     | Is one of: store_enabled or shipping_enabled or products_enabled                                         |
| store.settings.arabic_numbers_enabled              | bool     | Does the merchant wants the numbers to be shown as Arabic format                                         |
| store.settings.is_multilingual                     | bool     |                                                                                                          |
| store.settings.currencies_enabled                  | bool     |     
| theme                                              | Theme    |                                                                                                          |
| theme.id                                           | int      |                                                                                                          |
| theme.name                                         | string   |                                                                                                          |
| theme.mode                                         | string   | `live`, `preview`                                                                                        |
| theme.is_rtl                                       | bool     |                                                                                                          |
| theme.translations_hash                            | int      | to be used in case merchant updated frontend store translations                                          |
| theme.color                                        | object   |                                                                                                          |
| theme.color.primary                                | string   |                                                                                                          |
| theme.color.text                                   | string   | suitable text color comparing to `theme.primary.color`, #000000, #FFFFFF                                 |
| theme.color.reverse_primary                        | string   |                                                                                                          |
| theme.color.reverse_text                           | string   | if `theme.text_color=#000000` means that `theme.reverse_text_color=#FFFFFF`                              |
| theme.color.is_dark                                | bool     | Does main store color `theme.primary.color` considered as dim color?                                     |
| theme.color.darker(float alpha, ?string hexColor)  | string   | get darker color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0             |
| theme.color.lighter(float alpha, ?string hexColor) | string   | get lighter color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0            |
| theme.font                                         | ?object  | Salla predefined font, null when the theme doesn't have `fonts` feature                                  |
| theme.font.name                                    | string   | DINNextLTArabic-Regular, Amazon-Ember, Apple, Dubai, Estedad                                             |
| theme.font.url                                     | string   | css full url ex: 'https://my_store.test/dist/fonts/default.css'                                          |
| theme.settings                                     | object   | dynamic object with values of the `settings` in twilight.json ex. `theme.settings.topnav_is_dark`        |
| theme.settings.set(settingName, value)             | string   | set global var, then get it {{theme.settings.get('my_var','fallback') }}                                 |
| theme.settings.get(settingName, default=null)      | mixed    | get theme setting ex `theme.settings.get('my_var', 'fallback')`                                          |
#}
{#
  ─────────────────────────────────────────────────────────────────────────────
  T-3.01 — the document shell. Technique A, registered in /docs/OVERRIDES.md.

  The table above is upstream's and is left intact: it is the only documentation
  of what every template in this theme receives, and deleting it to make room
  for this note would cost more than it saves.

  FOUR THINGS WERE WAITING ON THIS FILE, AND ALL FOUR ARE CLOSED HERE. A theme
  setting reaches CSS only through a template, so until this shadow existed the
  merchant's choices were stored, validated, documented — and inert:

    · `button-style-*` on <body>        the corner-shape setting (T-2.05)
    · `--color-brand-secondary`         the secondary colour setting (T-2.01)
    · the <noscript> copy               the theme's only hard-coded string (T-1.05)
    · `lang` / `dir` on <html>          already correct (T-1.04) — preserved verbatim

  THE <h1> CONTRACT is stated above `{% block content %}`, where a page author
  will read it. In short: `header.twig` owns the heading on Home and the page
  template owns it everywhere else. **The layout emits no fallback**, and the
  comment there records why the obvious one is a defect rather than a safety net.

  EVERY UPSTREAM HOOK IS PRESERVED — all six this file carries: `head:start`,
  `head`, `head:end`, `body:classes`, `body:start` and `body:end`. Salla injects
  tracking, custom CSS and legal text through them, and **a missing hook fails
  silently on a live store** rather than at build time, which is why they are
  listed here rather than left to be noticed.

  T-8.01 DID THE "REMAINDER DEFERRED" HALF OF THIS, AND NOT THE "INLINED" HALF.
  The one sheet became two: `app.css` render-blocking at 58.8 KB gzip, down from
  100.2, and `salla-components.css` at 44.7 KB loaded without blocking. What is
  still not done is inlining the above-fold rules, because deciding which rules
  those are needs a rendered storefront and a browser, and guessing at it means
  shipping a page that paints wrong rather than late. It is on the manual
  checklist rather than claimed here.

  The two other render-blocking sheets stay, and both are deliberate: the
  platform's font CSS, which first paint genuinely needs, and the icon font,
  whose glyphs are sized by the type scale and would reflow their controls if
  they arrived late.
  ─────────────────────────────────────────────────────────────────────────────
#}
<!DOCTYPE html>
{# T-1.04: emitted by the platform and correct as it stands. Do not touch. #}
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {#
      T-2.12 — THE FALLBACK IS `false`, AND THAT IS THE DESIGN'S ANSWER RATHER
      THAN A PREFERENCE. Upstream's enhanced add-to-cart toast is a card with the
      product's image, price, options and two actions. **No artboard draws it.**
      What every artboard draws for a successful add — `Add to Cart Notification`
      and `Shopping Cart Notification` among them — is the same slim toast every
      other message uses, which is `salla.notify`'s and which T-2.12 styles.

      The switch is kept, because a merchant may well want the richer one and it
      is a shipped, working feature. Only its default moves, so that a store
      installed and left alone looks like the design. Its three appearances in
      this file are one decision and must stay in step.
    #}
    {% if theme.settings.get('enable_add_product_toast', false) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}


    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', false) }}"
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}"
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    {#
      T-8.01 — THE PLATFORM'S COMPONENT CSS, LOADED WITHOUT BLOCKING FIRST PAINT.

      `scripts/split-css.mjs` lifts every `s-*` rule out of the built sheet into
      this file: 364 KB raw, 44.7 KB gzip, which was 44% of what every page used
      to block on. **Nothing was purged to get it** — of the 1860 `s-*` classes
      only 79 are defined in the CSS Salla's components ship, so dropping them
      would un-style the platform's cart and filters at runtime. What changed is
      when they arrive.

      IT IS SAFE TO DEFER BECAUSE THERE IS NOTHING FOR IT TO PAINT YET. Every
      `salla-*` element is an empty custom element until `twilight.js` hydrates
      it, and hydration is itself deferred. CSS for markup that does not exist
      cannot shift a layout — which is the CLS question this had to answer
      before it was allowed.

      IT IS LINKED **BEFORE** `app.css`, AND THAT IS NOT A MISTAKE. Cascade order
      follows document order, not load order, so this keeps the exact order the
      two halves had inside one file: Tailwind's components and utilities first,
      the theme's own SCSS after. The files that deliberately override an `s-*`
      class — `floating-menu.scss`, `notifications.scss` — still win.

      `media="print"` is the fetch-without-blocking idiom; `onload` promotes it
      once it has arrived. The `<noscript>` copy is the fallback, and it is
      render-blocking on purpose: with no JS the `onload` never fires, and a
      store that renders unstyled is worse than one that paints late.
    #}
    <link rel="stylesheet" href="{{ 'salla-components.css' | asset }}" media="print" onload="this.media='all';this.onload=null;">
    <noscript><link rel="stylesheet" href="{{ 'salla-components.css' | asset }}"></noscript>
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
    
    {#
      The one block of CSS that cannot live in a stylesheet: it carries values
      only the platform and the merchant know. It loads after `app.css`, so it
      wins on order — which is what lets `global.scss` hold defaults for the same
      custom properties without either file having to know about the other.
    #}
    <style>
        :root {
            --font-main: '{{theme.font.name}}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
            {# T-2.01 — the merchant's secondary colour, and the only path it has
               to CSS. Emitted only when set, with no hex written here: the
               fallback belongs to `global.scss`, which is the token layer, and
               repeating the value in a template would put a raw hex outside it
               and give one colour two homes to drift between. #}
            {% if theme.settings.get('secondary_color') %}
            --color-brand-secondary: {{ theme.settings.get('secondary_color') }};
            {% endif %}
        }
    </style>
    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
{# T-2.05: `button-style-{rounded|pill|square}` is what makes the merchant's
   corner-shape setting real. `04-components/buttons.scss` styles the pill and
   square cases and lets `rounded` fall through to upstream's own radius. #}
<body id="app" class="theme-raed overflow-x-hidden {% hook 'body:classes' %}
  {{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  button-style-{{ theme.settings.get('button_style', 'rounded') }}
  ">
{# T-1.05: this was the theme's only hard-coded user-facing string — English
   prose shown to an Arabic-first audience. Two keys rather than one, because the
   link text has to stay inside the anchor and out of the sentence. #}
<noscript>
    {{ trans('theme.common.noscript') }}
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">{{ trans('theme.common.noscript_link') }}</a>
</noscript>
<div class="app-inner flex flex-col min-h-full">
    {% hook 'body:start' %}
    {% component 'header.header' %}
    <main id="main-content" role="main"{{ (page.slug == 'product.single' or page.slug starts with 'product.index') ? ' class="flex flex-col space-y-8 sm:space-y-16"' : '' }}>
    {#
      THE <h1> CONTRACT — T-3.01. Read this before adding a page template.

        · On Home, the <h1> is the store name, emitted visually-hidden by
          `header.twig`. A Home page template must NOT add one.
        · On every other page, `header.twig` emits the store name as an <h2>,
          and THE PAGE TEMPLATE OWNS THE <h1>. Exactly one, and it is normally
          the page's own visible title.

      The layout deliberately emits no fallback heading of its own. That was
      tried here first and it is wrong: a default <h1> in this position lands on
      top of the header's on Home and on top of every page template that already
      has one — turning a contract meant to guarantee *one* heading into a
      machine for producing two.

      A LAYOUT CANNOT ENFORCE THIS, AND PRETENDING OTHERWISE IS THE TRAP. It
      cannot count the headings a page renders inside `content`. What it can do
      is state the rule where the next person will read it, which is here, and
      have it checked at review. Verified page by page on 2026-08-08: every
      template under `src/views/pages` emits exactly one <h1>. **T-4.19, T-4.20
      and T-7.11 are new pages and each must add one.**
    #}
    {% block content %}{% endblock %}
    </main>
    {#
      T-3.03, second position. The artboard draws the marquee again between the
      last section and the footer, on Home and on no other page — the same
      condition the upper bar and the overlay header already share, so the three
      cannot disagree.

      It is here rather than in `footer.twig` because it is not part of the
      footer: it sits outside it in the artboard, and a merchant who turns the
      bar off should not be editing a footer template's business.
    #}
    {% if is_page('index') %}
        {% include 'components.announcement-bar' with { position: 'bottom' } %}
    {% endif %}

    {% component 'footer.footer' %}
</div>
{# T-3.10 — after the footer and outside `.app-inner`, so it is the last thing
   in the tab order on every page. A persistent utility should not stand in
   front of the page's own content. #}
{% include 'components.ui.whatsapp-fab' %}

{#
  T-4.13 — one quick-view sheet for the whole document, included here for the
  same reason the FAB is: product cards appear on Home, category, offers, brand
  and search, and a sheet per page would be five copies of one dialog. A sheet
  per *card* would be thirty. It is inert until a card's control names it.
#}
{% include 'components.ui.quick-view' %}

{% hook 'body:end' %}
{# T-2.12 — same default as the script tag above; see the note there. #}
{% if theme.settings.get('enable_add_product_toast', false) %}
    <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight Components #}
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>

{#
  T-5.01 — the bare `<salla-login-modal>` that stood here rendered its own
  centred `<salla-modal>`. `SignIn Bottom Sheet Step 1.pdf` draws a bottom sheet,
  and T-2.10 is the theme's answer to every overlay, so the component is included
  here `inline` inside that sheet instead. One per document, on every page,
  because `login::open` is dispatched from the header, the customer layout and
  the cart.
#}
{% include 'components.auth.login-sheet' %}
{% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
