{# ############## Shared Variables in all views ################
| Variable                                           | Type     | Description                                                                                              |
|----------------------------------------------------|----------|----------------------------------------------------------------------------------------------------------|
| store                                              | Store    |                                                                                                          |
| store.id                                           | int      |                                                                                                          |
| store.name                                         | string   |                                                                                                          |
| store.username                                     | string   |                                                                                                          |
| store.description                                  | string   |                                                                                                          |
| store.slogan                                       | ?string  | * if feature in twilight.json                                                                            |
| store.logo                                         | string   |                                                                                                          |
| store.url                                          | string   |                                                                                                          |
| store.api                                          | string   | the api url for current store                                                                            |
| store.icon                                         | string   | *fav icon url                                                                                            |
| store.contacts                                     | object   | [mobile, phone, email, whatsapp, telegram], ex. store.contacts.email                                     |
| store.social                                       | object   | [instagram, snapchat, twitter, youtube, facebook, pinterest, maroof, whatsapp], ex. store.social.twitter |
| store.settings                                     | object   |                                                                                                          |
| store.settings.auth.email_allowed                  | bool     |                                                                                                          |
| store.settings.auth.mobile_allowed                 | bool     |                                                                                                          |
| store.settings.auth.is_email_required              | bool     |                                                                                                          |
| store.settings.cart.apply_coupon_enabled           | bool     | Does visitor allowed to applay coupon in cart page                                                       |
| store.settings.product.total_sold_enabled          | bool     |                                                                                                          |
| store.settings.product.fit_type                    | ?string  | null when equal product card size is off, or ['cover', 'contain']                                        |
| store.settings.category.testimonial_enabled        | bool     | Show random testimonials in category page                                                                |
| store.settings.tax.number                          | ?string  |                                                                                                          |
| store.settings.tax.certificate                     | ?string  | certificate image url                                                                                    |
| store.settings.tax.taxable_prices_enabled          | bool     | Does tax included in the prices ex product_price 100 & tax is 15, price will be 115                      |
| store.settings.rating_enabled                      | bool     | Is one of: store_enabled or shipping_enabled or products_enabled                                         |
| store.settings.arabic_numbers_enabled              | bool     | Does the merchant wants the numbers to be shown as Arabic format                                         |
| store.settings.is_multilingual                     | bool     |                                                                                                          |
| store.settings.currencies_enabled                  | bool     |     
| theme                                              | Theme    |                                                                                                          |
| theme.id                                           | int      |                                                                                                          |
| theme.name                                         | string   |                                                                                                          |
| theme.mode                                         | string   | `live`, `preview`                                                                                        |
| theme.is_rtl                                       | bool     |                                                                                                          |
| theme.translations_hash                            | int      | to be used in case merchant updated frontend store translations                                          |
| theme.color                                        | object   |                                                                                                          |
| theme.color.primary                                | string   |                                                                                                          |
| theme.color.text                                   | string   | suitable text color comparing to `theme.primary.color`, #000000, #FFFFFF                                 |
| theme.color.reverse_primary                        | string   |                                                                                                          |
| theme.color.reverse_text                           | string   | if `theme.text_color=#000000` means that `theme.reverse_text_color=#FFFFFF`                              |
| theme.color.is_dark                                | bool     | Does main store color `theme.primary.color` considered as dim color?                                     |
| theme.color.darker(float alpha, ?string hexColor)  | string   | get darker color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0             |
| theme.color.lighter(float alpha, ?string hexColor) | string   | get lighter color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0            |
| theme.font                                         | ?object  | Salla predefined font, null when the theme doesn't have `fonts` feature                                  |
| theme.font.name                                    | string   | DINNextLTArabic-Regular, Amazon-Ember, Apple, Dubai, Estedad                                             |
| theme.font.url                                     | string   | css full url ex: 'https://my_store.test/dist/fonts/default.css'                                          |
| theme.settings                                     | object   | dynamic object with values of the `settings` in twilight.json ex. `theme.settings.topnav_is_dark`        |
| theme.settings.set(settingName, value)             | string   | set global var, then get it {{theme.settings.get('my_var','fallback') }}                                 |
| theme.settings.get(settingName, default=null)      | mixed    | get theme setting ex `theme.settings.get('my_var', 'fallback')`                                          |
#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {#
      The colour mode, decided before anything paints (owner request,
      2026-10-13). `dark_mode` is the merchant's default — light, dark, or the
      visitor's device; with `dark_mode_toggle` on, a visitor's own choice is
      kept in this browser and wins. Inline and first, so a dark page never
      flashes light. partials/color-mode.js owns the toggle.
    #}
    {% set am_color_mode = theme.settings.get('dark_mode', 'light') %}
    {% set am_color_toggle = theme.settings.get('dark_mode_toggle', false) %}
    {% if am_color_mode != 'light' or am_color_toggle %}
        <script data-cfasync="false">
            (function () {
                var mode = {{ am_color_mode|json_encode|raw }};
                {% if am_color_toggle %}
                try {
                    var saved = localStorage.getItem('am1als:color-mode');
                    if (saved === 'dark' || saved === 'light') mode = saved;
                } catch (e) {}
                {% endif %}
                if (mode === 'auto') {
                    mode = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                if (mode === 'dark') document.documentElement.classList.add('dark');
            })();
        </script>
    {% endif %}
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    {#
      Not `defer`, unlike upstream. salla-products-list decides which card to
      draw once, in componentWillLoad after salla.onReady(): custom-salla-product-card
      if it is already defined, salla-product-card otherwise. Deferred, this file
      lost that race on the demo store once the deferred CSS made pages render
      sooner, and every list fell back to the platform's card. It is small and
      only defines the element — nothing in it touches `salla` until a card
      connects, which happens after the SDK is ready.
    #}
    <script data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', false) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}


    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', false) }}"
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}"
    </script>
    {#
      T-3.03 — a dismissed announcement must be hidden before first paint, or it
      flashes in and collapses. The key hashes the text, so new copy shows again.
    #}
    {% if theme.settings.get('announcement_dismissible', false) %}
        <script data-cfasync="false">
            (function () {
                var text = {{ theme.settings.get('announcement_text')|default('')|json_encode|raw }};
                var hash = 5381;
                for (var i = 0; i < text.length; i++) {
                    hash = ((hash * 33) ^ text.charCodeAt(i)) >>> 0;
                }
                window.announcement_dismiss_key = 'am1als:announcement:' + hash.toString(36);
                try {
                    if (window.localStorage.getItem(window.announcement_dismiss_key)) {
                        document.documentElement.classList.add('announcement-dismissed');
                    }
                } catch (e) {
                    /* storage unavailable — the bar simply stays, which is the safe side */
                }
            })();
        </script>
    {% endif %}

    {# The theme's own strings for its JavaScript — salla.lang has only the
       platform's. Generated; see scripts/js-translations.mjs. #}
    {% include 'components.js-translations' %}

    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    {#
      T-8.01 — no stylesheet blocks first paint. The rules the top of the page
      needs are inlined (components/critical-css.twig, written by
      scripts/extract-critical.mjs on every build); the platform's component
      CSS (salla-components.css, split out of app.css by scripts/split-css.mjs)
      and the rest of app.css are fetched without blocking — `media="print"`
      then promoted on load. The <noscript> copies are the fallback, and are
      blocking on purpose: with no JS the onload never fires, and a store that
      renders unstyled is worse than one that paints late.
    #}
    {% include 'components.critical-css' %}
    <link rel="stylesheet" href="{{ 'salla-components.css' | asset }}" media="print" onload="this.media='all';this.onload=null;">
    <noscript><link rel="stylesheet" href="{{ 'salla-components.css' | asset }}"></noscript>
    <link rel="stylesheet" href="{{ 'app.css' | asset }}" media="print" onload="this.media='all';this.onload=null;">
    <noscript><link rel="stylesheet" href="{{ 'app.css' | asset }}"></noscript>
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
    
    {# The gradient is on only when both colours are chosen — one colour is not a
       gradient, and a half-set pair must not paint anything. #}
    {% set gradient_ready = theme.settings.get('gradient_color_start') and theme.settings.get('gradient_color_end') %}
    <style>
        :root {
            --font-main: '{{theme.font.name}}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
            {% if theme.settings.get('secondary_color') %}
            --color-brand-secondary: {{ theme.settings.get('secondary_color') }};
            {% endif %}
            {% if theme.settings.get('color_page_background') %}
            --surface-page: {{ theme.settings.get('color_page_background') }};
            {% endif %}
            {% if theme.settings.get('color_text_primary') %}
            --main-text-color: {{ theme.settings.get('color_text_primary') }};
            {% endif %}
            {% if theme.settings.get('color_header_background') %}
            --surface-header: {{ theme.settings.get('color_header_background') }};
            {% endif %}
            {% if theme.settings.get('color_header_text') %}
            --text-header: {{ theme.settings.get('color_header_text') }};
            {% endif %}
            {% if theme.settings.get('color_footer_background') %}
            --surface-footer: {{ theme.settings.get('color_footer_background') }};
            {% endif %}
            {% if theme.settings.get('color_footer_text') %}
            --text-footer: {{ theme.settings.get('color_footer_text') }};
            {% endif %}
            {% if theme.settings.get('color_button_background') %}
            --color-button-bg: {{ theme.settings.get('color_button_background') }};
            {% endif %}
            {% if theme.settings.get('color_button_text') %}
            --color-button-text: {{ theme.settings.get('color_button_text') }};
            {% endif %}
            {% if theme.settings.get('color_icons') %}
            --color-icon: {{ theme.settings.get('color_icons') }};
            {% endif %}
            {% if theme.settings.get('announcement_bg') %}
            --announcement-bg: {{ theme.settings.get('announcement_bg') }};
            {% endif %}
            {% if theme.settings.get('announcement_text_color') %}
            --announcement-text: {{ theme.settings.get('announcement_text_color') }};
            {% endif %}
            {% if theme.settings.get('whatsapp_fab_bg') %}
            --whatsapp-fab-bg: {{ theme.settings.get('whatsapp_fab_bg') }};
            {% endif %}
            {% if theme.settings.get('whatsapp_fab_icon_color') %}
            --whatsapp-fab-icon: {{ theme.settings.get('whatsapp_fab_icon_color') }};
            {% endif %}
            {# Owner request 2026-10-13 — the logo sizes and the page gutter, in px.
               `default` keeps a 0 gutter, which is a real choice: Twig's `empty`
               does not treat 0 as empty. #}
            --logo-height: {{ theme.settings.get('header_logo_height')|default(32) }}px;
            --footer-logo-height: {{ theme.settings.get('footer_logo_height')|default(40) }}px;
            --page-gutter: {{ theme.settings.get('page_gutter')|default(16) }}px;
            {% if theme.settings.get('store_background_image') %}
            --store-bg-image: url("{{ theme.settings.get('store_background_image')|cdn(1920) }}");
            {% endif %}
            {% if theme.settings.get('dark_background_image') %}
            --store-bg-image-dark: url("{{ theme.settings.get('dark_background_image')|cdn(1920) }}");
            {% endif %}
            {% if gradient_ready %}
            --gradient-start: {{ theme.settings.get('gradient_color_start') }};
            --gradient-end: {{ theme.settings.get('gradient_color_end') }};
            {% endif %}
        }
        {# The merchant's dark colours. Same specificity as the theme's dark
           defaults in global.scss and later in the page, so they win. #}
        html.dark {
            {% if theme.settings.get('dark_color_page') %}
            --surface-page: {{ theme.settings.get('dark_color_page') }};
            {% endif %}
            {% if theme.settings.get('dark_color_surface') %}
            --surface-section: {{ theme.settings.get('dark_color_surface') }};
            --surface-card: {{ theme.settings.get('dark_color_surface') }};
            --surface-header: {{ theme.settings.get('dark_color_surface') }};
            --surface-footer: {{ theme.settings.get('dark_color_surface') }};
            {% endif %}
            {% if theme.settings.get('dark_color_text') %}
            --main-text-color: {{ theme.settings.get('dark_color_text') }};
            --text-header: {{ theme.settings.get('dark_color_text') }};
            --text-footer: {{ theme.settings.get('dark_color_text') }};
            {% endif %}
        }
    </style>
    {# T-8.04 — the store as an Organization. Every field is guarded: a store with
       no logo emits no `logo` key — an empty value in structured data is a claim
       that it is empty. json_encode throughout, so a quote in the store name
       cannot break the JSON. #}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": {{ store.name|json_encode|raw }},
            "url": {{ store.url|default(link('/'))|json_encode|raw }}
            {%- if store.logo %},
            "logo": {{ store.logo|json_encode|raw }}
            {%- endif %}
            {%- if store.description %},
            "description": {{ store.description|striptags|trim|json_encode|raw }}
            {%- endif %}
            {%- if store.contacts.mobile or store.contacts.email %},
            "contactPoint": {
                "@type": "ContactPoint",
                "contactType": "customer service"
                {%- if store.contacts.mobile %},
                "telephone": {{ store.contacts.mobile|json_encode|raw }}
                {%- endif %}
                {%- if store.contacts.email %},
                "email": {{ store.contacts.email|json_encode|raw }}
                {%- endif %}
            }
            {%- endif %}
        }
    </script>

    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
<body id="app" class="theme-raed overflow-x-hidden {% hook 'body:classes' %}
  {{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  button-style-{{ theme.settings.get('button_style', 'rounded') }}
  {# The listing pages are drawn on the warm ground (page-background.scss). #}
  {{ (page.slug starts with 'product.index' or page.slug == 'brands.single') ? ' page--listing' : '' }}
  {{ theme.settings.get('enable_animations', true) ? '' : ' motion-off' }}
  {{ gradient_ready and theme.settings.get('gradient_on_buttons') ? ' gradient-buttons' : '' }}
  {{ gradient_ready and theme.settings.get('gradient_on_quantity') ? ' gradient-quantity' : '' }}
  {{ gradient_ready and theme.settings.get('gradient_on_bars') ? ' gradient-bars' : '' }}
  ">
{# T-1.05: this was the theme's only hard-coded user-facing string — English
   prose shown to an Arabic-first audience. Two keys, because the link text has
   to stay inside the anchor and out of the sentence. #}
<noscript>
    {{ trans('theme.common.noscript') }}
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">{{ trans('theme.common.noscript_link') }}</a>
</noscript>
{# `relative` anchors Home's overlay header (absolute, top 0) to this wrapper
   rather than to the page. The platform mounts its own bars as siblings before
   it — `salla-maintenance-alert` on the demo store (2026-10-14) — and without
   this the header sat on top of them instead of beneath. #}
<div class="app-inner relative flex flex-col min-h-full">
    {% hook 'body:start' %}
    {# T-8.14 — a zero-height marker at the top of the document for
       partials/back-to-top.js: when it leaves a box grown one viewport upward,
       the visitor has scrolled a screenful. No measuring on scroll. #}
    <div data-back-to-top-sentinel aria-hidden="true"></div>
    {% component 'header.header' %}
    <main id="main-content" role="main"{{ (page.slug == 'product.single' or page.slug starts with 'product.index') ? ' class="flex flex-col space-y-8 sm:space-y-16"' : '' }}>
    {% block content %}{% endblock %}
    </main>
    {% if is_page('index') %}
        {% include 'components.announcement-bar' with { position: 'bottom' } %}
    {% endif %}
    {% component 'footer.footer' %}
</div>
{% hook 'body:end' %}
{# T-3.09 / T-3.10 — the WhatsApp button and T-8.14 — back to top. Both render
   nothing unless enabled, and the WhatsApp one also needs the store's number. #}
{% include 'components.ui.whatsapp-fab' %}
{% include 'components.ui.back-to-top' %}
{#
  T-4.13 — one quick-view sheet for the whole document: product cards appear on
  Home, category, offers, brand and search. It is inert until a card's control
  names it.
#}
{% include 'components.ui.quick-view' %}
{# T-8.15 — the discount popup. It renders nothing unless the merchant enables
   it, and partials/discount-popup.js decides when it opens. #}
{% include 'components.ui.discount-popup' %}
{% if theme.settings.get('enable_add_product_toast', false) %}
    <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight Components #}
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>
{#
  T-5.01 — Salla's own login modal, as upstream ships it. Master put it
  `inline` inside the theme's sheet and bridged the two by assigning the
  component's `modal` field from outside (partials/auth.js). On a real store
  the components are lazy-loaded, so the element is a proxy and that field
  lives on a separate instance: the assignment never reached it, and the
  header's account icon stopped opening anything. Reverted 2026-10-12; recorded
  in DERIVED-DECISIONS.md.
#}
<salla-login-modal data-testid="store-login-modal"></salla-login-modal>
{% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
