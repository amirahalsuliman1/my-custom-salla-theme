{#
| Variable                         | Type                              | Description                                                                              |
|----------------------------------|-----------------------------------|------------------------------------------------------------------------------------------|
| page                             | object                            |                                                                                          |
| page.title                       | string                            |                                                                                          |
| page.slug                        | string                            |                                                                                          |
| order                            | Order                             |                                                                                          |
| order.id                         | integer                           |                                                                                          |
| order.reference_id               | integer                           |                                                                                          |
| order.created_at                 | date                              |                                                                                          |
| order.sub_total                  | float                             |                                                                                          |
| order.total                      | float                             |                                                                                          |
| order.cod_cost                   | float                             | * Cash On Delivery                                                                       |
| order.can_reorder                | bool                              |                                                                                          |
| order.can_cancel                 | bool                              |                                                                                          |
| order.can_rate                   | bool                              |                                                                                          |
| order.cancel_url                 | string                            |                                                                                          |
| order.payment_url                | string                            |                                                                                          |
| order.is_pending_payment         | bool                              |                                                                                          |
| order.pending_payment_ends_in    | int                               | How much many seconds untile pending payment ends, zero if it's already expired          |
| order.shipping                   | ?object                           |                                                                                          |
| order.shipping.id                | integer                           |                                                                                          |
| order.shipping.name              | string                            |                                                                                          |
| order.shipping.number            | string                            | number/string/link (..) for shipment number (tracking number)                            |
| order.shipping.logo              | ?string                           |                                                                                          |
| order.shipping.cost              | ?Money                            |                                                                                          |
| order.shipments[]                | ShipmentObject[]                  |                                                                                          |
| order.tax                        | ?object                           |                                                                                          |
| order.tax.amount                 | float                             |                                                                                          |
| order.tax.percent                | float                             |                                                                                          |
| order.status                     | object                            |                                                                                          |
| order.status.name                | string                            |                                                                                          |
| order.status.icon                | string                            |                                                                                          |
| order.status.color               | string                            |                                                                                          |
| order.items                      | OrderItem[]                       |                                                                                          |
| order.options                    | OrderOption[]                     |                                                                                          |
| order.items[].name               |                                   |                                                                                          |
| order.items[].image              |                                   |                                                                                          |
| order.items[].price              | TaxableMoney                      |                                                                                          |
| order.items[].quantity           |                                   |                                                                                          |
| order.items[].total              | TaxableMoney                      |                                                                                          |
| order.items[].product            | ?Product                          | There are cases product is null, when merchant adds special product to the order         |
| order.items[].sub_products       | ?Product[] *Collection            |                                                                                          |
| order.items[].note               |                                   |                                                                                          |
| order.items[].attachments        | OrderItemAttachment[] *Collection | if it's empty will be empty array so you can use it as check `{% if item.attachments %}` |
| order.items[].attachments[].type | string                            |                                                                                          |
| order.items[].attachments[].url  | string                            |                                                                                          |
| order.items[].options            | ?OrderItemOption[] *Collection    |                                                                                          |
| order.items[].options[].name     | string                            |                                                                                          |
| order.items[].options[].value    | string                            |                                                                                          |
| order.items[].options[].is_image | bool                              |                                                                                          |
| order.items[].options[].color    | string                            | option hex color                                                                         |
| order.items[].rating             | ?Rating                           |                                                                                          |
| order.items[].rating.content     | string                            | *HTML                                                                                    |
| order.items[].rating.is_pending  | bool                              |                                                                                          |
| order.items[].rating.stars       | int                               |                                                                                          |
| order.items[].rating.images      | array                             |                                                                                          |
| order.items[].rating.created_at  | date                              |                                                                                          |
| order.discounts                  | array                             |                                                                                          |
| order.discounts[].name           | string                            |                                                                                          |
| order.discounts[].discount       | float                             | minus number                                                                             |
| order.is_rated                   | bool                              |                                                                                          |
| order.rating                     | ?OrderRatings                     |                                                                                          |
| order.rating.store               | ?Rating                           |                                                                                          |
| order.rating.shipping            | ?Rating                           |                                                                                          |
| order.rating.product             | ?array                            | Product ratings array with factor_reviews                                                |
| order.links                      | array                             |                                                                                          |
| order.links[].url                | string                            |                                                                                          |
| order.links[].label              | string                            |                                                                                          |
| order.links[].type               | string                            | One of ['print', 'shipment', 'digital']                                                  |
#}
{#
  T-6.02 — the order's own page. Technique A, and **derived rather than drawn**.

  THERE IS NO ARTBOARD FOR THIS PAGE, AND THE TWO THE BACKLOG NAMED ARE A
  DIFFERENT SCREEN. `Order Confirmation.pdf` and `Order Confirmation - Close
  Dropdown.pdf` draw «إتمام الطلب والدفع» — the three-step checkout, with address
  selection, an add-address form, shipping-company choice and «ادفع». That is
  **step two of the very stepper AC-4 ruled out**, on the grounds that steps two
  and three are Salla-hosted pages this theme does not render. Reported to the
  owner on 2026-08-11 rather than folded into this page, per CLAUDE.md's standing
  stop condition. **The owner ruled: derive the order page from T-6.01's
  components** — recorded as AC-10.

  SO THE DESIGN LANGUAGE IS THE ONE ALREADY ON DISK, AND NOT ONE PATTERN IS NEW.
  Every block is `.account-panel` — the surface T-5.08 declared, T-5.10 reused
  and T-6.01's card sits on. The status is `components.orders.status`. The
  product rows are `components.orders.item`, **the same partial the orders list
  renders**, with this page's extra detail passed into its `extra` slot. The
  totals are `salla-order-totals-card`, exactly as the list card uses it. A
  rating already left is `components.orders.rating`, which replaced three
  near-identical upstream blocks with one.

  NOTHING THE PLATFORM SHIPS WAS DROPPED TO MAKE IT LOOK TIDIER, AND THAT IS THE
  RULE RATHER THAN A PREFERENCE. T-5.04 kept the hide-my-name control the artboard
  omitted; T-3.08 kept the VAT number. The same standard applies with more force
  where there is no artboard at all: `salla-edit-order-button`, `salla-order-branch`,
  `salla-order-details`, `salla-review-factors-tags`, the booking reservations,
  the item attachments, the availability date, the price-quote notice and the
  refund message are all still here, on the new surface. **A derivation is a
  change of clothes, not a change of contents.**

  THE TWO MODALS ARE STILL `salla-modal`, ON PURPOSE. `order.js` binds
  `#btn-reorder` and `#confirm-cancel` inside them, and T-6.03 and T-6.04 own the
  flows that replace them with T-2.11's dialog. Converting them here would have
  been this task doing two other tasks' work, badly and without their artboards.
#}
{% extends "layouts.customer" %}

{% block inner_title %}
    <div class="order-page__title">
        <h1 class="order-page__heading">
            {{ page.title }}
            {% if order.source is same as('buy_as_gift') %}
                <span class="order-page__gift">
                    {% include 'components.ui.icon' with { name: 'gift-sharing' } only %}
                    {{ trans('pages.orders.gift_tag') }}
                </span>
            {% endif %}
        </h1>

        {# The platform's own control. It renders itself away where editing is
           not offered, which is the gate this theme must not second-guess. #}
        <salla-edit-order-button data-testid="store-order-edit-btn"></salla-edit-order-button>
    </div>
{% endblock %}

{% block inner_content %}
    {% hook 'customer:orders.single.details.start' %}

    {#
      THE HEADER PANEL — the same four facts T-6.01's card header carries, in the
      same arrangement, so an order looks like itself on both pages.
    #}
    <section class="account-panel order-page__summary">
        <div class="order-card__header">
            <div class="order-card__identity">
                <p class="order-card__id">
                    <span class="sr-only">{{ trans('pages.thank_you.order_id') }}</span>
                    #{{ order.reference_id }}
                </p>
                <time class="order-card__date" datetime="{{ order.created_at|date('Y-m-d') }}">
                    {{ order.created_at|date('d/m/Y') }}
                </time>
            </div>

            <div class="order-card__summary">
                {#
                  An expired payment window replaces the status rather than
                  sitting beside it — upstream's own reading, and the more useful
                  one: «بانتظار الدفع» on an order that can no longer be paid is
                  worse than no status at all.
                #}
                {% if order.is_pending_payment and order.pending_payment_ends_in == 0 %}
                    <p class="order-card__expired">{{ trans('pages.orders.pending_payment_expired') }}</p>
                {% else %}
                    {% include 'components.orders.status' with { status: order.status } only %}
                {% endif %}
            </div>
        </div>

        {% if order.is_price_quote %}
            <p class="order-page__notice">
                {% include 'components.ui.icon' with { name: 'info' } only %}
                <span>{{ trans('pages.orders.your_order_is_under_review') }}</span>
            </p>
        {% endif %}

        <div class="order-page__links">
            {#
              The platform's links, with the platform's own labels — the same
              array T-6.01's card reads, and the same reason for not naming them
              here. `target="_blank"` is upstream's; `rel` is not, and a
              cross-origin `_blank` without it hands the opened page a handle on
              this one.
            #}
            {% for link in order.links|default([]) %}
                <a class="order-card__invoice" href="{{ link.url }}" target="_blank" rel="noopener">
                    {% include 'components.ui.icon' with { name: 'printer2' } only %}
                    <span>{{ link.label }}</span>
                </a>
            {% endfor %}

            {#
              «طباعة الفاتورة» has two states in upstream and both are kept: a
              button where the store allows it, and an explanation where it does
              not. The explanation was a hover tooltip, which is unreachable by
              keyboard — it is a paragraph now, tied to nothing and readable by
              everyone, which is what it was always trying to be.
            #}
            {% if can_print_invoice %}
                {% include 'components.ui.button' with {
                    label:   trans('pages.orders.print'),
                    icon:    'printer2',
                    variant: 'secondary',
                    class:   'order-page__print',
                    attrs:   { onclick: "window.open('" ~ order.print_url() ~ "', '_blank', 'toolbar=yes, scrollbars=yes, resizable=yes, width=900, height=700');" }
                } only %}
            {% else %}
                <p class="order-page__notice">
                    {% include 'components.ui.icon' with { name: 'info' } only %}
                    <span>
                        {{ trans('pages.orders.to_order_invoice_contact_vendor') }}
                        {{ trans('pages.orders.print_order_details') }}
                        <a class="order-page__link" href="{{ order.print_url() }}" target="_blank" rel="noopener">
                            {{ trans('pages.orders.click_here') }}
                        </a>
                    </span>
                </p>
            {% endif %}
        </div>
    </section>

    {#
      T-6.06 — THE TRACKING SECTION, AND IT IS ON THIS PAGE BECAUSE THERE IS
      NOWHERE ELSE TO PUT IT. The backlog names a new `orders/tracking.twig`;
      **Salla routes no such page.** The template list is closed — home, product,
      listing, cart, blog, brands, loyalty, thank-you, single-page, landing, and
      five customer pages — and neither this theme nor upstream has ever carried a
      tracking template. A file for an unrouted slug renders nowhere. Reported to
      the owner on 2026-08-11; **the ruling was to derive it onto the order page
      and record what is missing** — AC-11.

      **THE ARTBOARD DRAWS NINE STEPS WITH DATES AND TWO ARE BUILT, WHICH IS
      EVERY ONE THE PLATFORM CAN PRODUCE.** «بانتظار اعتماد الطلب» through «تم
      التقييم» is this store's own fulfilment pipeline. `order.status` is a single
      *current* status; there is no list of a store's statuses and **no history
      with timestamps anywhere in the SDK, the components or the docs.** Inventing
      seven labels and seven dates would put a fabricated delivery history on a
      customer's screen. What is real is exactly two facts — the order was
      created, on a date it carries, and it is now at a status it names — and that
      is what renders. Raised as **OP-12**.
    #}
    {% if order.status.name %}
        {% set tracking_steps = [
            { label: trans('theme.orders.step_placed'), date: order.created_at, state: 'done' },
            { label: order.status.name, state: 'current' }
        ] %}

        <section class="account-panel" data-order-tracking data-order-id="{{ order.id }}">
            {% include 'components.ui.order-timeline' with {
                title: trans('theme.orders.tracking_title'),
                steps: tracking_steps,
                level: 2
            } only %}
        </section>
    {% endif %}

    {% if order.is_pickable %}
        <salla-order-branch data-testid="store-order-branch" stack-cards></salla-order-branch>
    {% endif %}

    {% if order.refund_message %}
        <p class="account-panel order-page__notice order-page__notice--panel">
            {% include 'components.ui.icon' with { name: 'refund' } only %}
            <span>{{ order.refund_message|raw }}</span>
        </p>
    {% endif %}

    {% if store.settings.rating.allow_update and order.rating is not empty %}
        <p class="account-panel order-page__notice order-page__notice--panel">
            {% include 'components.ui.icon' with { name: 'info' } only %}
            <span>
                {{ trans('pages.order.can_edit_or_delete_your_review_within') }}
                {{ store.settings.rating.update_period }}
                {{ trans('pages.order.days_since_added') }}.
            </span>
        </p>
    {% endif %}

    {#
      THE RATING PROMPT. Upstream drew it on a gradient band; no account page in
      this theme has one, and T-5.10 removed the last of them. It is a panel with
      the invitation and the button, and the button still dispatches `rating::open`
      — T-6.08 owns what opens.
    #}
    {% if order.can_rate %}
        <section class="account-panel order-page__rate">
            <div>
                <h2 class="order-page__rate-title">{{ trans('pages.order.order_rating_title') }}</h2>
                <p class="order-page__rate-message">{{ trans('pages.order.order_rating_message') }}</p>
            </div>

            {% include 'components.ui.button' with {
                label:   trans('pages.rating.rate'),
                variant: 'primary',
                attrs:   { 'data-testid': 'store-order-rate-btn', onclick: "salla.event.dispatch('rating::open')" }
            } only %}
        </section>
    {% endif %}

    {#
      THE SHIPMENTS. One panel per package, because that is what a package is —
      a set of items travelling together, with its own carrier and its own
      tracking number.
    #}
    {% for package in order.packages %}
        <section class="account-panel order-package">
            {% if package.shipping_company and not order.is_pickable %}
                <header class="order-package__header">
                    <div class="order-package__carrier">
                        {% if package.shipping_company.logo %}
                            <img src="{{ package.shipping_company.logo }}"
                                 alt="{{ package.shipping_company.name }}"
                                 class="order-package__logo"
                                 width="64"
                                 height="32"
                                 loading="lazy">
                        {% endif %}
                        <span>{{ package.shipping_company.name }}</span>
                    </div>

                    <dl class="order-package__facts">
                        {% if package.branch %}
                            <div>
                                <dt>{{ trans('pages.orders.branch') }}</dt>
                                <dd>{{ package.branch.name }}</dd>
                            </div>
                        {% endif %}

                        {% if package.shipping_company.number %}
                            <div>
                                <dt>{{ trans('pages.orders.shipment_no') }}</dt>
                                <dd>{{ package.shipping_company.number|raw }}</dd>
                            </div>
                        {% endif %}

                        {#
                          A delivered package states its status; one still moving
                          offers the carrier's tracking link. Never both, which is
                          upstream's own branch and the right one — a tracking
                          link on a delivered package leads somewhere that says
                          nothing new.
                        #}
                        {% if package.is_delivered %}
                            <div>
                                <dt>{{ trans('pages.orders.status') }}</dt>
                                <dd>{% include 'components.orders.status' with { status: package.status } only %}</dd>
                            </div>
                        {% elseif package.shipping_company.tracing_link %}
                            <div>
                                <dt class="sr-only">{{ trans('pages.orders.tracking_url') }}</dt>
                                <dd>
                                    <a class="order-page__link" href="{{ package.shipping_company.tracing_link|raw }}" target="_blank" rel="noopener">
                                        {% include 'components.ui.icon' with { name: 'shipping' } only %}
                                        {{ trans('pages.orders.tracking_url') }}
                                    </a>
                                </dd>
                            </div>
                        {% endif %}
                    </dl>
                </header>
            {% endif %}

            <ul class="order-card__items">
                {% for item in package.items %}
                    {#
                      Everything this page knows about an item that the list does
                      not is captured here and handed to the shared row. The row
                      itself — image, name, price, options, quantity — is not
                      restated.
                    #}
                    {% set item_detail %}
                        <dl class="order-item__facts">
                            <div>
                                <dt>{{ trans('pages.orders.total') }}</dt>
                                <dd>{{ item.total|money }}</dd>
                            </div>
                        </dl>

                        {% if item.availability_date %}
                            <p class="order-page__notice">
                                {% include 'components.ui.icon' with { name: 'info' } only %}
                                <span>
                                    {{ trans('pages.products.expected_to_be') }}:
                                    <b>{{ item.availability_date|date('Y-m-d') }}</b>
                                </span>
                            </p>
                        {% endif %}

                        {% if item.product.type == 'booking' and item.product_reservations is not empty %}
                            {% if item.booking_location != null %}
                                <dl class="order-item__facts">
                                    <div>
                                        <dt>{{ trans('common.elements.location') }}</dt>
                                        <dd class="text-unicode">{{ item.booking_location }}</dd>
                                    </div>
                                </dl>
                            {% endif %}

                            <h4 class="order-item__subtitle">
                                {{ item.product_reservations.count() > 1
                                    ? trans('pages.cart.reservations')
                                    : trans('pages.cart.item_options') }}
                            </h4>

                            {% include 'pages.partials.product.reservations' with { reservations: item.product_reservations } %}
                        {% endif %}

                        {# Sub-products and per-item options, rendered by the platform. #}
                        <salla-order-details order-details="{{ item|json_encode }}"></salla-order-details>

                        {% if item.note %}
                            <p class="order-item__note">
                                <span>{{ trans('common.elements.note') }}:</span> {{ item.note }}
                            </p>
                        {% endif %}

                        {% if item.attachments %}
                            <dl class="order-item__facts">
                                {% for attachment in item.attachments %}
                                    <div>
                                        <dt>{{ trans('pages.products.attachments') }}</dt>
                                        <dd>
                                            <a href="{{ attachment.url }}" target="_blank" rel="noopener">
                                                {% if attachment.type == 'image' %}
                                                    <img class="order-item__attachment"
                                                         src="{{ attachment.url }}"
                                                         alt="{{ item.name }}"
                                                         width="28"
                                                         height="28"
                                                         loading="lazy">
                                                {% else %}
                                                    {{ trans('pages.orders.file_url') }}
                                                {% endif %}
                                            </a>
                                        </dd>
                                    </div>
                                {% endfor %}
                            </dl>
                        {% endif %}

                        {% if item.rating %}
                            {% set product_rating_extra %}
                                <salla-review-factors-tags
                                    order-id="{{ order.id }}"
                                    rating-id="{{ item.rating.id }}"
                                    item-id="{{ item.id }}"
                                    {% if item.product %}product-id="{{ item.product.id }}"{% endif %}
                                ></salla-review-factors-tags>

                                {% if item.rating.images|length %}
                                    <ul class="order-rating__images">
                                        {% for image in item.rating.images %}
                                            <li>
                                                <img src="{{ image }}"
                                                     alt="{{ item.name }}"
                                                     width="80"
                                                     height="80"
                                                     loading="lazy">
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            {% endset %}

                            {% include 'components.orders.rating' with {
                                rating: item.rating,
                                title:  item.name,
                                type:   'product',
                                extra:  product_rating_extra,
                                level:  4
                            } only %}
                        {% endif %}
                    {% endset %}

                    {% include 'components.orders.item' with {
                        item:  item,
                        link:  true,
                        extra: item_detail
                    } only %}
                {% endfor %}
            </ul>
        </section>
    {% endfor %}

    {% if order.options|length %}
        <section class="account-panel order-page__options">
            <h2 class="order-page__section-title">{{ trans('pages.cart.cart_options') }}</h2>

            <dl class="order-item__facts">
                {% for entry in order.options %}
                    {% for option in entry.options %}
                        <div>
                            <dt>{{ option.name }}</dt>
                            <dd>
                                {% if option.reservations %}
                                    {% include 'pages.partials.product.reservations' with { reservations: option.reservations } %}
                                {% else %}
                                    {{ option.value }}
                                {% endif %}
                                <b>{{ option.price|money }}</b>
                            </dd>
                        </div>
                    {% endfor %}
                {% endfor %}
            </dl>
        </section>
    {% endif %}

    {#
      The totals, and the same component the list card uses. "Totals match
      Salla's computation exactly — no client-side arithmetic" is met by there
      being no arithmetic in this theme's path at all.
    #}
    <salla-order-totals-card class="account-panel order-card__totals"
                             data-testid="store-order-totals"
                             order="{{ order }}"></salla-order-totals-card>

    {#
      THE ACTIONS. One panel, the same three the list card offers, in the same
      order — pay, reorder, cancel — each behind the platform's own flag.
    #}
    {% if order.can_reorder or order.can_cancel or order.is_pending_payment %}
        <section class="account-panel order-page__actions">
            <div class="order-card__actions">
                {% if order.is_pending_payment %}
                    {% if order.pending_payment_ends_in == 0 %}
                        <p class="order-card__expired">{{ trans('pages.orders.pending_payment_expired') }}</p>
                    {% else %}
                        {% include 'components.ui.button' with {
                            label:   trans('pages.orders.finish_payment'),
                            icon:    'wallet',
                            href:    order.payment_url,
                            variant: 'primary',
                            class:   'order-card__action'
                        } only %}
                    {% endif %}
                {% elseif user.type == 'user' and order.can_reorder %}
                    {% include 'components.ui.button' with {
                        label:   trans('pages.orders.reorder'),
                        icon:    'rotate',
                        variant: 'primary',
                        class:   'order-card__action',
                        attrs:   { 'data-testid': 'store-order-reorder-btn', 'data-order-reorder': order.id, 'data-sheet-open': 'reorder-order-dialog' }
                    } only %}
                {% endif %}

                {% if order.can_cancel %}
                    {#
                      T-6.03: `data-sheet-open` is T-2.10's own opener and
                      `data-order-cancel` says which order — the same pair the
                      list card carries, so one script serves both pages.
                    #}
                    {% include 'components.ui.button' with {
                        label:   trans('pages.orders.cancel'),
                        icon:    'cancel-circle',
                        variant: 'error',
                        class:   'order-card__action order-card__action--cancel',
                        attrs:   { 'data-testid': 'store-order-cancel-btn', 'data-order-cancel': order.id, 'data-sheet-open': 'cancel-order-dialog' }
                    } only %}
                {% endif %}
            </div>

            {#
              The description upstream put beside each button is kept as the
              panel's own sentence rather than repeated per action — it explains
              what cancelling means, which is the thing a customer needs before
              pressing it.
            #}
            {% if order.can_cancel %}
                <p class="order-page__hint">{{ trans('pages.order.order_cancelation_desc') }}</p>
            {% elseif order.can_reorder %}
                <p class="order-page__hint">{{ trans('pages.orders.reorder_description') }}</p>
            {% endif %}
        </section>

        {# T-6.04 — T-2.11's dialog, replacing upstream's `salla-modal`. #}
        {% if user.type == 'user' and order.can_reorder %}
            {% include 'components.orders.reorder-dialog' %}
        {% endif %}

        {#
          T-6.03 — `salla-modal` is gone and this is T-2.11's dialog, which is
          what `01 Cancel Order Confirmation Pop-up.pdf` draws. One per page, and
          the trigger above says which order.
        #}
        {% if order.can_cancel %}
            {% include 'components.orders.cancel-dialog' %}
        {% endif %}
    {% endif %}

    {% if order.rating.store.stars %}
        {% include 'components.orders.rating' with {
            rating: order.rating.store,
            title:  trans('pages.rating.rate_the_store'),
            type:   'store',
            level:  2
        } only %}
    {% endif %}

    {% if order.rating.shipping.stars %}
        {% include 'components.orders.rating' with {
            rating: order.rating.shipping,
            title:  trans('pages.rating.rate_shipping'),
            type:   'shipping',
            level:  2
        } only %}
