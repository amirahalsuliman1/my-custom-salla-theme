{#
| Variable                   | Type        | Description                                                          |
|----------------------------|-------------|----------------------------------------------------------------------|
| page                       | object      |                                                                      |
| page.title                 | string      | *could be html                                                       |
| page.slug                  | string      | ex: "cat.show"                                                       |
| category                   | ?Category   |                                                                      |
| category.name              | string      |                                                                      |
| category.url               | string      |                                                                      |
| category.sub_categories    | ?Category[] |                                                                      |
| category.image             | ?string     |                                                                      |
| filters                     | bool        | is filters allowed here or not                                        |
| sort_options[]             | SortList[]  |                                                                      |
| sort_options[].id          | string      | ourSuggest, bestSell, topRated, priceFromTopToLow, priceFromLowToTop |
| sort_options[].name        | string      |                                                                      |
| sort_options[].is_selected | bool        | Is current page sorted by it                                         |
| search_query               | ?string     |                                                                      |
#}
{% extends "layouts.master" %}
{% block content %}
	{#
	  T-4.16 — THE OFFERS PAGE IS THIS TEMPLATE, and that was read out of the repo
	  rather than assumed. `src/assets/js/products.js` boots on
	  `product.index`, `product.index.latest`, **`product.index.offers`**,
	  `product.index.search` and `product.index.tag` — one template, five slugs.
	  So no `pages/offers.twig` is created; the backlog entry's «Files affected»
	  named one and is corrected there.

	  THE HERO IS GATED ON THE SLUG AND ON THE SETTING, both. A category page must
	  not inherit the offers cover, and a merchant who sets no cover must not get
	  an empty band — the page falls back to its plain title, which is upstream's
	  own layout and needs nothing added to it.
	#}
	{% set is_offers_page = page.slug == 'product.index.offers' %}
	{% set is_search_page = page.slug == 'product.index.search' %}
	{% set listing_cover = is_offers_page ? theme.settings.get('offer_banner') : null %}

	{% if listing_cover %}
		{#
		  The artboard puts the breadcrumb and the title over the image, so both
		  move inside the cover here rather than being duplicated — `#page-main-title`
		  must exist exactly once, because `products.js` writes the fetched title
		  into it by id.

		  `width`/`height` and an aspect-ratio reserve the box before the image
		  arrives. It is the first thing on the page, so it loads eagerly and is
		  `fetchpriority="high"`: it is the LCP element on this page and telling
		  the browser so is free.
		#}
		<div class="listing-cover">
			<img class="listing-cover__image"
				 src="{{ listing_cover|cdn(900) }}"
				 srcset="{{ listing_cover|cdn(450) }} 450w, {{ listing_cover|cdn(900) }} 900w, {{ listing_cover|cdn(1350) }} 1350w"
				 sizes="100vw"
				 alt=""
				 width="393"
				 height="420"
				 loading="eager"
				 fetchpriority="high">

			<div class="listing-cover__overlay">
				<div class="container">
					{% if theme.settings.get('product_index_show_breadcrumbs', true) %}
						<nav class="breadcrumbs listing-cover__breadcrumbs">
							<salla-breadcrumb></salla-breadcrumb>
						</nav>
					{% endif %}

					<h1 class="listing-cover__title" id="page-main-title">{{ page.title|raw }}</h1>
				</div>
			</div>
		</div>
	{% endif %}

	{% if theme.settings.get('product_index_show_breadcrumbs', true) and not listing_cover %}
		<div
			class="container container--breadcrumbs">
			{# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
			<nav class="breadcrumbs w-full py-5">
				<salla-breadcrumb></salla-breadcrumb>
			</nav>
		</div>
	{% endif %}

	{#
	  The merchant's listing banner (owner request, 2026-10-13), under the
	  breadcrumb on category and other listing pages. Not on offers, which has
	  its own cover, and not on search, where a promotion would sit between a
	  customer and the answer to the question they just typed.
	#}
	{% if not is_offers_page and not is_search_page %}
		<div class="container">
			{% include 'components.ui.promo-banner' with {
				image:  theme.settings.get('listing_banner_image'),
				url:    theme.settings.get('listing_banner_url'),
				alt:    theme.settings.get('listing_banner_alt'),
				testid: 'store-listing-banner'
			} only %}
		</div>
	{% endif %}

	{#
	  The category's interactive cover (public-theme pass, 2026-10-19): a Home
	  shoppable image whose section names this category, with its points and
	  pills, read from Home by partials/lookbook-elsewhere.js. Hidden until found.
	#}
	{% if page.slug == 'product.index' %}
		<div class="category-look-mount">
			<div class="category-look" data-lookbook-mount data-for-category="{{ page.id }}" data-for-category-name="{{ page.title|striptags|trim }}" hidden>
				<div data-lookbook-slot></div>
			</div>
		</div>
	{% endif %}

	{#
	  The category's own customer stories (public-theme pass, 2026-10-19): the
	  Home «تجارب عملائنا» stories whose category tags include this category's
	  name, in the PDP strip's row. `partials/pdp-stories.js` fills it near the
	  viewport and leaves it hidden when no story carries the tag. Categories
	  only — not offers, search or tag pages, which have no category name.
	#}
	{% if page.slug == 'product.index' and theme.settings.get('category_stories_enabled', true) %}
		<div class="product-stories-mount">
			<section class="s-block container product-stories category-stories" data-testid="store-category-stories"
					 data-pdp-stories
					 data-filter-tag="{{ page.title|striptags|trim }}"
					 data-limit="12"
					 aria-labelledby="category-stories-title"
					 hidden>
				<div class="s-block__panel">
					{% include 'components.ui.section-header' with {
						title: trans('theme.product.stories_title'),
						align: 'start',
						level: 2,
						id: 'category-stories-title'
					} %}
					<ul class="product-stories__track" data-pdp-stories-track></ul>
					<div class="product-carousel__indicator product-stories__indicator" data-pdp-stories-indicator aria-hidden="true" hidden>
						<span class="product-carousel__thumb"></span>
					</div>
				</div>
			</section>
		</div>
	{% endif %}

	{#
    Hook: product.index.before_products_group_with_filter
    Fires before the products grid and filter sidebar wrapper.
    Use this hook to inject content above the products listing area.
  #}
	<div class="s-blocks-wrapper s-before-products-list !mt-0">{% hook 'product.index.before_products_group_with_filter' %}</div>

	<div class="container container--products-list flex items-start flex-col md:flex-row" data-grid-density="{{ theme.settings.get('listing_grid_default', 'small') }}">
		{#
		  T-4.18 — THE FILTERS, IN T-2.10's DRAWER BELOW LAPTOP AND IN THE PAGE
		  ABOVE IT.

		  What was here was `mmenu-light` — the library T-3.06 removed from
		  `app.js` after finding its bundle contains **zero** occurrences of
		  `aria`, `focus`, `keydown` or `tabindex`. So the listing filters were
		  the same inaccessible drawer that task rejected: focus neither trapped
		  nor returned, `Esc` doing nothing, the page behind it still tabbable.
		  Every one of those is a criterion here, and none of them is reachable
		  from CSS.

		  `salla-filters` itself is untouched — technique C, as the entry
		  requires. Only its container changed.
		#}
		{% if filters %}
			{# One partial, shared with the brand page: the drawer, `salla-filters`
			   inside it, and the header `Show Filter.pdf` draws. #}
			{% include 'components.ui.filters-sheet' with { testid: 'store-products-filters' } %}
		{% endif %}

		<div class="main-content flex-1 w-full {{ filters ? 'ltr:lg:ml-8 rtl:lg:mr-8' : '' }}">
			{#
			  THE TOOLBAR, AND WHERE THE COVER PUTS IT.

			  `Offers Page.pdf` draws the sort select at the inline start, filling
			  the row, and the 47pt funnel square at the inline end — so the select
			  comes first in source and grows, and the funnel follows it. In RTL that
			  is select on the right and funnel on the left, as drawn; it was the
			  mirror image, with the select shrunk to its longest option.

			  From 1024px both desktop listing artboards lift the select onto the
			  cover's title row, at the inline end, and start the filter column and
			  the grid together under it. The select is rendered once — `products.js`
			  binds `#product-filter` by id — so `listing.scss` moves this same row
			  (`--over-cover`) rather than a second copy being printed into the cover.
			#}
			<div class="listing-toolbar mb-4 sm:mb-6 flex items-center{{ listing_cover ? ' listing-toolbar--over-cover' : ' justify-between' }}">
				{# The title lives in the cover when there is one; see the top of this file. #}
				{% if not listing_cover %}
					{#
					  T-4.20 — THE SEARCH TITLE IS NOT `|raw`, AND THAT IS THE POINT.

					  Upstream renders `page.title|raw` because the docblock says it
					  «could be html» — true for a category, whose title a merchant
					  writes. On the search page the title carries **the visitor's own
					  query**, so `|raw` reflects whatever was typed into the URL
					  straight into the document. `products.js` compounded it by
					  assigning the fetched title with `innerHTML`.

					  So the search page echoes `search_query` through Twig's
					  auto-escaping instead, and never the raw title. Every other slug
					  keeps upstream's behaviour, because a merchant's category title
					  is authored content and this is not.
					#}
					{% if is_search_page %}
						<h1 class="font-bold text-xl rtl:pl-3 ltr:pr-3" id="page-main-title">
							{{ trans('theme.search.results_for', { 'query': search_query }) }}
						</h1>
					{% else %}
						<h1 class="font-bold text-xl rtl:pl-3 ltr:pr-3" id="page-main-title">{{ page.title|raw }}</h1>
					{% endif %}
				{% endif %}
				<div class="listing-toolbar__controls flex items-center gap-2{{ listing_cover ? ' w-full' : '' }}">
					{% if sort_options|length %}
						<div class="listing-toolbar__sort flex items-center{{ listing_cover ? ' flex-1 min-w-0' : '' }}">
							{#
							  T-4.19 — the label was `hidden sm:block`, so below 640
							  the select had **no accessible name at all**: no visible
							  label, no `aria-label`, nothing. A screen reader
							  announced it as an unnamed combo box on the one
							  viewport every artboard is drawn at. `sr-only` instead
							  of `hidden` keeps the artboard's appearance — the label
							  is still invisible on mobile — and gives the control
							  its name back. Same pixels, different silence.
							#}
							{# No artboard draws the label at any width — the desktop listing
							   draws the select alone — and from 640px it showed and wrapped to
							   two lines beside it (demo store, 2026-10-14). Named, not shown. #}
							<label class="sr-only" for="product-filter">{{ trans('pages.categories.sorting') }}</label>
							<select id="product-filter" class="form-input pt-0 pb-1 rtl:md:pl-10 ltr:md:pr-10">
								{% for sort in sort_options %}
									<option value="{{ sort.id }}" {{ sort.is_selected?'selected':'' }}>{{ sort.name }}</option>
								{% endfor %}
							</select>
						</div>
					{% endif %}
					{#
					  The grid-size toggle (public-theme pass, 2026-10-19): fewer,
					  larger products or more, smaller ones. `partials/grid-density.js`
					  sets `data-grid-density` on the list's container and keeps the
					  shopper's choice in their browser; listing.scss draws the columns.
					#}
					{% if theme.settings.get('listing_grid_toggle', true) %}
						<div class="grid-density" role="group" aria-label="{{ trans('theme.listing.grid_label') }}">
							<button type="button" class="grid-density__btn" data-grid-density-set="large" aria-pressed="false" aria-label="{{ trans('theme.listing.grid_large') }}">
								<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
							</button>
							<button type="button" class="grid-density__btn" data-grid-density-set="small" aria-pressed="false" aria-label="{{ trans('theme.listing.grid_small') }}">
								<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="11.5" y="3" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="3" y="11.5" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="11.5" y="11.5" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
							</button>
						</div>
					{% endif %}
					{#
					  T-4.18 — a real `<button>`, not an anchor to `#filters-menu`.

					  Upstream's trigger was an `<a href="#…">` whose handler called
					  `preventDefault()`, so it navigated nowhere: a link that is not
					  a link, and announced as one. It also carried **no accessible
					  name at all** — the icon was its only content and the icon is
					  decorative. `data-sheet-open` is T-2.10's own contract, and it
					  is what returns focus to this button when the drawer closes.
					#}
					{% if filters %}
						<button type="button"
								data-testid="store-products-filters-mobile-trigger"
								data-sheet-open="filters-sheet"
								aria-haspopup="dialog"
								class="filters-trigger lg:hidden"
								aria-label="{{ trans('theme.filters.title') }}">
							<i class="sicon-filter" aria-hidden="true"></i>
						</button>
					{% endif %}
				</div>
			</div>

			{#
			  T-4.20 — the result count, and the reason it is on every listing
			  rather than only on search.

			  The criterion is search's — «count announced to assistive tech on
			  change» — but the thing that changes a count is a FILTER, and
			  filters are on every listing slug. A region that only existed on
			  search would go quiet on the page where it matters most. Empty
			  until the first fetch, so it announces a change rather than a
			  starting value nobody asked for.

			  ANNOUNCED EVERYWHERE, SHOWN ONLY ON SEARCH. Neither `Offers Page.pdf`
			  nor either desktop listing artboard draws a count line between the
			  sort row and the grid, so on the slugs they cover it is `sr-only` —
			  still in the accessibility tree from load, which is what keeps its
			  announcements reliable. Search has no artboard, and T-4.20's own
			  criterion keeps the count visible there.
			#}
			<p class="listing-count {{ is_search_page ? 'listing-count--visible' : 'sr-only' }}" data-listing-count role="status" aria-live="polite"></p>

			{% hook 'product:index.items.start' %}

			<div class="flex">
				<salla-products-list data-testid="store-products-list"
									 class="listing__products flex-1 min-w-0 overflow-auto"
									 source="{{ page.slug }}"
									 source-value="{{ page.id }}"
									 {% if theme.settings.get('listing_products_per_page') %}limit="{{ theme.settings.get('listing_products_per_page') }}"{% endif %}
									 {% if theme.settings.get('listing_default_sort') %}sort-by="{{ theme.settings.get('listing_default_sort') }}"{% endif %}
									 {{ filters ?'filters-Results':'' }}></salla-products-list>
			</div>

			{#
			  T-4.19 — THE EMPTY RESULT, which the component does not do the way
			  this task requires. `salla-products-list` renders its own
			  `<div class="s-products-list-placeholder">` with a bag and a
			  sentence — and **no way onward**. It also does not emit
			  `.no-content-placeholder`, so T-2.14's retune, which reaches five
			  upstream templates without editing any of them, does not reach this
			  one.

			  So T-2.14's component is rendered here, hidden, and `products.js`
			  swaps the two when a fetch comes back empty. The component is not
			  modified and its placeholder is not deleted — it is hidden, so a
			  future SDK that adds an action to it can simply be un-hidden.

			  T-4.20 needs the route onward more than this page does: a search
			  with no results and no way out is a dead end, which is the one thing
			  that criterion names.
			#}
			<div class="listing-empty" data-listing-empty hidden>
				{% include 'components.ui.empty-state' with {
					icon:         'shopping-bag',
					message:      trans('pages.categories.no_products'),
					action_label: trans('common.elements.back_home'),
					action_href:  link('/'),
					testid:       'store-products-empty'
				} only %}
			</div>

			{% hook 'product:index.items.end' %}
		</div>
	</div>

	{#
    Hook: product.index.after_products_group_with_filter
    Fires after the products grid and filter sidebar wrapper.
    Use this hook to inject content below the products listing area.
  #}
	<div class="s-blocks-wrapper s-after-products-list">{% hook 'product.index.after_products_group_with_filter' %}</div>

	{% if store.settings.category.testimonial_enabled %}
		{% component 'home.testimonials' %}
	{% endif %}

	{#
    Hook: product.index.after_testimonials
    Fires after the testimonials (store reviews) section.
    Use this hook to inject content below the testimonials area.
  #}
	<div class="s-blocks-wrapper s-after-testimonials">{% hook 'product.index.after_testimonials' %}</div>
{% endblock %}

{% block scripts %}
	{#
	  `media.js` first. Since T-8.03 the `product` bundle is built with
	  `dependOn: ['app', 'media']`, and webpack does not run a bundle until the
	  chunks it depends on are loaded — so without this tag `product.js` never
	  executed on any listing page: no sort control, no item-list schema, no grid
	  toggle, no category stories or cover (found 2026-10-19). The product page
	  has always loaded both.
	#}
	<script defer src="{{ 'media.js' | asset }}"></script>
	<script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
