{#
| Variable                               | Type                        | Description                                                            |
|----------------------------------------|-----------------------------|------------------------------------------------------------------------|
| page                                   | object                      |                                                                        |
| page.title                             | string                      | *could be html                                                         |
| page.slug                              | string                      | ex: "cat.show"                                                         |
| product                                | Product                     |                                                                        |
| product.id                             | int                         |                                                                        |
| product.name                           | string                      |                                                                        |
| product.description                    | string                      | HTML                                                                   |
| product.url                            | string                      |                                                                        |
| product.promotion_title                | string                      |                                                                        |
| product.subtitle                       | string                      |                                                                        |
| product.type                           | string                      | product, service, group_products, codes, digital, food, donating       |
| product.status                         | string                      | sale, out, out-and-notify                                              |
| product.weight                         | ?string                     |                                                                        |
| product.calories                       | ?float                      |                                                                        |
| product.sku                            | ?string                     |                                                                        |
| product.rating                         | ?Rating                     |                                                                        |
| product.rating.count                   | int                         |                                                                        |
| product.rating.stars                   | int                         |                                                                        |
| product.price                          | float                       | can be string too `-`, when merchant doesn't want to show zero         |
| product.sale_price                     | float                       |                                                                        |
| product.regular_price                  | float                       |                                                                        |
| product.starting_price                 | ?float                      |                                                                        |
| product.quantity                       | ?int                        | if it's null, means it's unlimited                                     |
| product.sold_quantity                  | int                         |                                                                        |
| product.max_quantity                   | int                         |                                                                        |
| product.discount_ends                  | ?date                       |                                                                        |
| product.is_taxable                     | bool                        | Is the tax included in the price                                       |
| product.category                       | ?Category                   |                                                                        |
| product.category.name                  | string                      |                                                                        |
| product.category.url                   | string                      |                                                                        |
| product.image                          | object                      |                                                                        |
| product.image.url                      | string                      |                                                                        |
| product.image.alt                      | ?string                     |                                                                        |
| product.images                         | array                       |                                                                        |
| product.images[].id                    | int                         |                                                                        |
| product.images[].url                   | string                      |                                                                        |
| product.images[].alt                   | ?string                     |                                                                        |
| product.images[].video_url             | ?string                     |                                                                        |
| product.images[].type                  | string                      | `image` `video`                                                        |
| product.brand                          | ?object                     |                                                                        |
| product.brand.id                       | int                         |                                                                        |
| product.brand.url                      | ?string                     |                                                                        |
| product.brand.name                     | ?string                     |                                                                        |
| product.brand.logo                     | ?string                     |                                                                        |
| product.tags                           | ?Tags[] *Collection         |                                                                        |
| product.tags[].name                    | string                      |                                                                        |
| product.tags[].url                     | string                      |                                                                        |
| product.options                        | ProductOption[] *Collection | @see views/pages/partials/product/options.twig                         |
| product.notify_availability            | ?object                     | does product outOfStock & can visitor subscribe to notify availability |
| product.notify_availability.channels   | array                       | ex: ['sms', 'email']                                                   |
| product.notify_availability.subscribed | bool                        | Does user subscribed before                                            |
| product.donation                       | ?ProductDonation            |                                                                        |
| product.donation.target_message        | ?string                     | Message if reached to target or target expired                         |
| product.donation.collected_amount      | float                       |                                                                        |
| product.donation.target_amount         | float                       |                                                                        |
| product.donation.target_percent        | float                       |                                                                        |
| product.donation.target_end_date       | ?Date                       |                                                                        |
| product.donation.can_donate            | bool                        | `true` When there is no campaign or (target not reached & not expired) |
| product.has_read_more                  | bool                        |                                                                        |
| product.can_add_note                   | bool                        |                                                                        |
| product.can_show_remained_quantity     | bool                        |                                                                        |
| product.can_show_sold                  | bool                        |                                                                        |
| product.can_upload_file                | bool                        |                                                                        |
| product.has_custom_form                | bool                        | Is it for  `Food` or `Custom Service` product                          |
| product.has_metadata                   | bool                        |                                                                        |
| product.has_options                    | bool                        |                                                                        |
| product.is_on_sale                     | bool                        | Product has discounted price                                           |
| product.is_hidden_quantity             | bool                        | The quantity is hidden by merchant, or product not available           |
| product.is_available                   | bool                        |                                                                        |
| product.is_in_wishlist                 | bool                        |                                                                        |
| product.is_out_of_stock                | bool                        |                                                                        |
| product.is_require_shipping            | bool                        |                                                                        |
| product.base_currency_price            | float                       | product.price with base currency (SAR)                                 |
| product.discount_percentage            | ?string                     | ex: "20%"                                                              |
| product.has_3d_image                   | bool                        |                                                                        |
| product.has_size_guide                 | bool                        |                                                                        |
| product.is_giftable                    | bool                        |                                                                        |
| product.add_to_cart_label              | string                      |                                                                        |
| product.currency                       | string                      |                                                                        |
#}
{% extends "layouts.master" %}
{% block content %}
    {% if theme.settings.get('product_show_breadcrumbs', true) %}
      <div class="container container--breadcrumbs">
          {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
          <nav class="breadcrumbs w-full py-5">
              <salla-breadcrumb></salla-breadcrumb>
          </nav>
      </div>
    {% endif %}

    {#
        Hook: product.single.before_product_info
        Fires before the main product information section (images, title, price, etc.).
        Use this hook to inject custom content or components above the product details area.
    #}
    <div class="s-blocks-wrapper s-before-product-info !mt-0">{% hook 'product.single.before_product_info' %}</div>

    {#
      T-4.10 — Product, AggregateRating and Offer schema.

      NOTHING IN `src/views` EMITTED A SINGLE LINE OF SCHEMA BEFORE THIS. Not
      JSON-LD, not one `itemscope` — grepped across the whole tree before it was
      written. The acceptance criterion was not partly met; it was unbuilt.

      JSON-LD AND NOT MICRODATA, WHICH IS THE OPPOSITE OF T-4.01's CALL AND FOR
      THE SAME REASON. The card used `<meta>` because its price is already in
      the markup as formatted text — `salla.money()` returns a string with the
      currency glyph embedded, which no parser can read. Here the whole object
      has to be described, including fields that appear nowhere on screen
      (`sku`, `availability`, `priceValidUntil`'s absence), and threading
      `itemprop` through a 400-line upstream template would put structured data
      in every future merge conflict. One block, one place, read from `product`.

      `price_as_float`-equivalent: `product.price` is the float the platform
      exposes; `product.currency` is its ISO code. Neither is the rendered text.
      The two must never be swapped for the visible values, which are localised.

      `AggregateRating` is emitted only when a rating exists. Google rejects the
      whole Product node for an `aggregateRating` with `reviewCount: 0`, so an
      unrated product is better described without one than with an empty one.
    #}
    {#
      T-8.04 — THE BREADCRUMB TRAIL, AND THIS IS THE ONLY PAGE THAT CAN EMIT ONE.

      `<salla-breadcrumb>` builds its trail **client-side**, from
      `salla.api.navigation.fetchBreadcrumbs`. No Twig variable carries the trail
      on any page, so a `BreadcrumbList` cannot be written server-side anywhere —
      **except here**, where `product.category` gives the one hop that matters:
      home › category › this product.

      **The other pages therefore emit nothing rather than something invented**,
      which is the «no schema for content absent from the page» criterion read
      strictly: a trail the template cannot see is not a trail it may guess.

      The last item carries no `item` URL, which is correct rather than an
      omission — the current page is where the reader already is, and Google's
      own guidance is to leave the final `item` off.
    #}
    {% if product.category and product.category.name %}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": {{ trans('theme.common.home')|json_encode|raw }},
                    "item": {{ url('/')|json_encode|raw }}
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": {{ product.category.name|json_encode|raw }}
                    {%- if product.category.url %},
                    "item": {{ product.category.url|json_encode|raw }}
                    {%- endif %}
                },
                {
                    "@type": "ListItem",
                    "position": 3,
                    "name": {{ product.name|json_encode|raw }}
                }
            ]
        }
    </script>
    {% endif %}

    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Product",
            "name": {{ product.name|json_encode|raw }},
            "url": {{ product.url|json_encode|raw }},
            {% if product.image.url %}"image": {{ product.image.url|json_encode|raw }},{% endif %}
            {% if product.description %}"description": {{ product.description|striptags|trim|json_encode|raw }},{% endif %}
            {% if product.sku %}"sku": {{ product.sku|json_encode|raw }},{% endif %}
            {% if product.brand.name %}"brand": { "@type": "Brand", "name": {{ product.brand.name|json_encode|raw }} },{% endif %}
            {% if product.rating and product.rating.count %}
            "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": {{ product.rating.stars|json_encode|raw }},
                "reviewCount": {{ product.rating.count|json_encode|raw }}
            },
            {% endif %}
            "offers": {
                "@type": "Offer",
                "url": {{ product.url|json_encode|raw }},
                "price": {{ product.price|json_encode|raw }},
                "priceCurrency": {{ product.currency|json_encode|raw }},
                "availability": "https://schema.org/{{ product.is_available ? 'InStock' : 'OutOfStock' }}"
            }
        }
    </script>

    {#
      T-4.09 — THE PRODUCT DETAILS PANEL, which the gallery is only the first
      thing inside. `Product Details Page.svg` puts the gallery and the whole
      info block on one `#F7F6F4` panel at `y306 w393 h1033 rx24` — **full
      bleed, not the 16px-inset `.s-block__panel` T-2.18 built.** Different
      shape, so it is a different class rather than a reuse that would have to
      be undone. It opens here because the gallery is its first child;
      **T-4.10 fills the rest of it.**
    #}
    <div class="product-details-panel">
    <div class="container container--product-details">
        <div class="flex flex-col items-start md:flex-row" id="product-{{ product.id }}">
            {# `me-8` and not upstream's `rtl:ml-8 ltr:mr-8`: the same margin, in
               the logical property T-1.04 requires, without a variant per side. #}
            <div class="sidebar product-gallery md:sticky top-24 w-full md:!w-2/4 me-8 mb-5 md:mb-0 overflow-hidden shrink-0">
                {% set has_many_images = product.images|length > 1 %}
                <salla-slider
                        data-testid="store-product-image-slider"
                        id="details-slider-{{ product.id }}"
                        class="details-slider rounded-md image-slider"
                        type="thumbs"
                        loop="false"
                        listen-to-thumbnails-option
                        show-thumbs-controls="false">
                    {% if product.promotion_title %}
                        <div class="promotion-title">{{ product.promotion_title }}</div>
                    {% endif %}

                    {# T-4.11 — the wishlist button moved out of the image and down
                       beside «أضف إلى السلة», where the artboard draws it. #}
                    {# Calories Badge #}
                    {% if product.calories %}
                        <div class="absolute z-[2] top-4 rtl:left-4 ltr:right-4 bg-white shadow-sm flex flex-col justify-center items-center rounded-full w-20 h-20 md:w-24 md:h-24">
                            <span class="text-red-500 text-xl leading-none font-bold">{{ product.calories }}</span>
                            <span class="text-xs text-gray-500">{{ trans('pages.products.calories') }}</span>
                        </div>
                    {% endif %}

                    <div slot="items">
                        {% for image in product.images %}
                            {% if image.three_d_image_url %}
                                <model-viewer style="min-height: 500px;" class="swiper-slide model-entry w-full h-full"
                                    loading="eager" camera-controls
                                    touch-action="pan-y" auto-rotate
                                    poster="{{ image.url }}"
                                    src="{{ image.three_d_image_url }}"
                                    shadow-intensity="1" alt="{{ image.alt }}">
                                </model-viewer>
                                    {% else %}
                                <a data-fslightbox="product_{{ product.id }}"
                                   data-img-id="{{ image.id }}"
                                   data-slid-index="{{ loop.index-1 }}"{% if image.video_url %} data-video-src="{{ image.video_url }}"{% endif %}
                                   data-caption="{{ image.alt }}"
                                   data-infinite="false"
                                   data-type="{{ image.video_url?'youtube':'image' }}"
                                   href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                                   aria-label="{{ trans('theme.product.zoom_image', {'name': product.name, 'position': loop.index, 'total': product.images|length}) }}"
                                   class="swiper-slide magnify-wrapper homeslider__slide {{ image.video_url?'video-entry':'' }}">
                                    {#
                                      T-4.09 — `alt` falls back to the product name.
                                      `image.alt` is nullable on every Salla image and
                                      most merchants never fill it, so upstream's bare
                                      `alt="{{ image.alt }}"` ships an **empty alt on
                                      the page's main image** — which tells a screen
                                      reader the product photo is decorative. The name
                                      is the honest fallback; a filled `alt` still wins.
                                    #}
                                    {% if loop.first %}
                                        <img id="{{image.id}}" fetchpriority="high" loading="eager" decoding="sync" src="{{ image.url }}"
                                             alt="{{ image.alt|default(product.name) }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% else %}
                                        <img id="{{image.id}}" src="{{ image.url }}"
                                             loading="lazy" decoding="async"
                                             alt="{{ image.alt|default(product.name) }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {#
                      T-4.09 — THE THUMBNAILS ARE BUTTONS NOW, AND THAT IS THE
                      DEFECT THIS TASK FOUND. `salla-slider type="thumbs"` drives
                      the strip with Swiper's thumbs module and **does not enable
                      Swiper's a11y module**, so upstream's thumbs are bare
                      `<div>`s: no tab stop, no role, no name, and nothing at all
                      saying which one is showing. The whole gallery was reachable
                      by pointer only.

                      A `<button>` **inside** the slide rather than as the slide:
                      the component stamps `swiper-slide` onto each direct child
                      of this container, and a `<button>` carrying swiper's layout
                      is a fight not worth having. Click still reaches Swiper by
                      bubbling, so the thumbs module keeps working untouched.

                      `aria-current` is set by `product-gallery.js` from swiper's
                      own `swiper-slide-thumb-active` class — the state is read
                      from the component rather than tracked in parallel.
                    #}
                    {% if has_many_images %}
                        <div data-testid="store-product-thumbnails" slot="thumbs">
                            {% for image in product.images %}
                                <div class="slide--one-fourth product-gallery__thumb-slide {{ image.video_url?'video-entry':'' }} {{ image.three_d_image_url?'model-entry':'' }}" data-caption="{{ image.alt }}">
                                    <button type="button"
                                            class="product-gallery__thumb"
                                            aria-current="false"
                                            aria-label="{{ trans('theme.product.show_image', {'position': loop.index, 'total': product.images|length}) }}">
                                        <img src="{{ image.url }}"
                                             loading="{{ loop.index < 5 ? 'eager' : 'lazy' }}"
                                             decoding="async"
                                             class="object-cover w-full h-full rounded-md overflow-hidden"
                                             alt=""/>
                                    </button>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </salla-slider>

                {#
                  The scroll indicator, and it is T-4.03's — the same classes, the
                  same two custom properties, the same tokens. T-2.19 measured that
                  control and CLAUDE.md allows exactly one implementation of it, so
                  this consumes it rather than drawing a second bar that happens to
                  look the same. `aria-hidden`, for the reason the other two carry:
                  it reports a position the thumbnails themselves already announce.
                #}
                {% if has_many_images %}
                    <div class="product-carousel__indicator product-gallery__indicator" aria-hidden="true">
                        <span class="product-carousel__thumb"></span>
                    </div>
                {% endif %}
            </div>

            <div class="main-content md:sticky md:overflow-hidden top-24 w-full md:w-2/4">
                {% hook 'product:single.description.start' %}

                {#
                  T-4.10 — the brand is its NAME here, not its logo.

                  The artboard writes «Rhode» as text above the title. Upstream
                  renders `brand.logo` inside a `w-12` box, which on this design
                  would be a 48px image where the export draws a line of type —
                  and `brand.logo` is nullable, so upstream's markup can ship a
                  broken image box on a brand that has a name and no logo. The
                  name is the field that is always there when `brand` is.
                #}
                {% if product.brand.name %}
                    <p class="product-brand">
                        <a href="{{ product.brand.url }}">{{ product.brand.name }}</a>
                    </p>
                {% endif %}

                <h1 data-testid="store-product-title" class="text-xl md:text-2xl leading-10 font-bold mb-6 text-gray-800">{{ product.name }}</h1>

                {% if product.subtitle %}
                    <h2 class="product-entry__sub-title text-sm text-gray-500 leading-6 mb-2.5">
                        {{ product.subtitle }}
                    </h2>
                {% endif %}

                {% if product.rating %}
                    <salla-rating-stars data-testid="store-product-rating" value="{{ product.rating.stars }}"
                                        reviews="{{ product.rating.count }}"></salla-rating-stars>
                {% endif %}

                {% if product.is_taxable %}
                    <small class="color-grey">{{ trans('pages.products.tax_included') }}</small>
                {% endif %}
                {# Price #}
                <div data-testid="store-product-price" class="flex whitespace-nowrap gap-4 items-center">
                  <div class="{{ product.is_on_sale ? '' : 'hidden' }} space-x-2 rtl:space-x-reverse whitespace-nowrap">
                      <p class="text-red-800 font-bold text-xl inline-block">{{product.sale_price|money}}</p>
                      <span class="text-gray-500 line-through">{{product.regular_price|money}}</span>
                  </div>
                  <div class="gap-4 {{ product.is_on_sale ? 'hidden' : 'flex' }}">
                      {% if product.starting_price %} 
                          <span class="">{{ trans('pages.products.starting_price') }}</span>
                      {% endif %} 
                          <p class=" font-bold text-xl inline-block"> {{product.starting_price ? product.starting_price|money : product.price|money }}</p>
                  </div>
                </div>

                <div data-testid="store-product-description" class="product__description p-2 px-5 sm:p-1 leading-7 mb-3">
                    {% set product_desc = product.description|replace({"&nbsp;":"\n"}) %}
                    {% if product.has_read_more %}
                        <article class="article article--main relative leading-8 overflow-hidden transition-all max-h-0 duration-300 py-4"
                            id="more-content" style="max-height:5.25rem">
                            {{ product_desc|raw }}
                        </article>

                        {# Read More Button #}
                        <a id="btn-show-more" class="link--primary inline-block mt-2 cursor-pointer">
                            {{ trans('pages.products.read_more') }}
                        </a>
                    {% else %}
                        <article class="article--main pb-1">
                            {{ product_desc|raw }}
                        </article>
                    {% endif %}
                </div>

                {% if product.tags|length and theme.settings.get('show_tags', true) %}
                    <div class="mb-3">
                        {% for tag in product.tags %}
                            <a href="{{ tag.url }}"
                               class="rtl:ml-2 ltr:mr-2 inline-flex  text-gray-500 hover:text-primary underline text-sm mb-1">{{ tag.name }}
                                ,</a>
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="flex rtl:space-x-reverse space-x-3">
                    <salla-social-share data-testid="store-product-social-share" class="inline-flex mb-5" aria-label="social share"></salla-social-share>

                    <salla-button
                            data-testid="store-product-wishlist-btn"
                            class="btn--wishlist animated hidden sm:inline-flex"
                            data-id="{{ product.id }}"
                            onclick="salla.wishlist.toggle('{{ product.id }}')"
                            shape="icon"
                            fill="outline"
                            color="light"
							aria-label="add to wishlist">
                        <i class="sicon-heart"></i>
                    </salla-button>
                </div>

                {% if product.sold_quantity or product.can_show_remained_quantity %}
                    <div class="bg-white py-2.5 mb-5 rounded-md inline-flex text-sm">
                        {% if product.sold_quantity %}
                            <div class="px-4 !text-red-800">
                                <i class="sicon-fire rtl:ml-1.5 ltr:mr-1.5"></i> {{ trans('pages.products.sold') }}
                                <span>{{ pluralize('pages.products.sold_times', product.sold_quantity)|raw }}</span>
                            </div>
                        {% endif %}
                        {% if product.can_show_remained_quantity %}
                            <div class="px-4 rtl:even:border-r ltr:even:border-l even:border-gray-200">
                                <i class="!text-red-800 sicon-box-bankers rtl:ml-1.5 ltr:mr-1.5"></i>
                                {{ trans('pages.products.remained') }}
                                <span>{{ product.quantity }}</span>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
                {% if product.sku %}
                    <div class="mb-4 flex justify-between sm:grid sm:grid-cols-3 bg-white rounded-md px-4 py-2">
                        <div class="flex items-center">
                            <i class="sicon-barcode mx-1"></i>
                            {{ trans('pages.products.sku') }}
                        </div>
                        <div class="text-unicode product-sku">{{ product.sku }}</div>
                    </div>
                {% endif %}
                {% hook 'product:single.description' %}

                {# Installment Methods #}
                <salla-installment data-testid="store-product-installment" price="{{ product.price }}"></salla-installment>
                {% if product.has_metadata %}
                <salla-metadata data-testid="store-product-metadata"></salla-metadata>
                {% endif %}

                {% if product.show_availability %}
                    <section class="bg-white p-5 rounded-md mb-5 last:mb-0">
                        <div class="center-between">
                            <label class="flex items-center text-base">
                                <span class="sicon-location rtl:ml-1 ltr:mr-1"></span>
                                <span class="inline-block">{{ trans('pages.products.availability') }}</span>
                            </label>
                            <div class="mt-1 sm:mt-0 sm:col-span-2 text-end">
                                <div class="flex rtl:space-x-reverse space-x-3">
                                    <a href="#!"
                                       onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })"
                                       class="group text-primary flex items-center justify-center">
                                        <span>{{ trans('pages.products.select_branch') }}</span>
                                        <span class="sicon-keyboard_arrow_left mr-2 transition-all group-hover:-translate-x-1"></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                {% endif %}


              {# Digital Files Settings #}
              {% if product.digital_files_settings %}
                <digital-files-settings settings='{{ product.digital_files_settings|json_encode }}'></digital-files-settings>
              {% endif %}
              {# End Digital Files Settings #}

                <form data-testid="store-product-form" class="form product-form" enctype="multipart/form-data" method="post"
                      onsubmit="return salla.form.onSubmit('cart.addItem', event)" >
                    <input type="hidden" name="id" value="{{ product.id }}">


                    {% hook 'product:single.form.start' %}

                    {% include 'pages.partials.product.options' %}

                    {% hook 'product:single.form.end' %}

                    <section class="flex bg-white p-5 sm:pb-0 rounded-md rounded-b-none">
                        <div class="center-between w-full">
                            <label class="form-label">
                                <b class="block">
                                    {{ trans('pages.products.price') }}
                                </b>
                            </label>

                            {#
                              T-4.10 — THE LIVE REGION, AND THE `<h2>`s THAT WERE NOT HEADINGS.

                              `product.js` rewrites `.total-price` on every
                              `salla.product.event.onPriceUpdated`, which is what fires
                              when a variant is chosen. Nothing announced it: the price
                              changed silently for anyone not looking at it. `aria-live`
                              on the wrapper is the criterion, and `polite` rather than
                              `assertive` because the customer caused the change and is
                              not to be interrupted mid-selection.

                              The two `<h2>`s were **prices, not headings.** They put the
                              price into the document outline between the `<h1>` and the
                              real section headings below, so a screen reader's heading
                              list read «The summer kit → 595 ﷼». The class is what
                              `product.js` targets, so the class stays and the element
                              becomes a `<strong>` — same weight, no outline entry.
                            #}
                            <div class="flex whitespace-nowrap price-wrapper gap-4 items-center"
                                 aria-live="polite"
                                 aria-atomic="true">
                              <div class="{{ product.is_on_sale ? '' : 'hidden' }} price_is_on_sale space-x-2 rtl:space-x-reverse whitespace-nowrap">
                                <strong class="total-price text-red-800 font-bold text-xl inline-block">{{product.sale_price|money}}</strong>
                                <span class="before-price text-gray-500 line-through">{{product.regular_price|money}}</span>
                              </div>
                              <div class="starting-or-normal-price gap-4 {{ product.is_on_sale ? 'hidden' : 'flex' }}">
                                {% if product.starting_price %}
                                  <span class="starting-price-title">{{ trans('pages.products.starting_price') }}</span>
                                {% endif %}
                                <strong class="total-price font-bold text-xl inline-block"> {{product.starting_price ? product.starting_price|money : product.price|money }}</strong>
                              </div>
                            </div>

                            {#
                              OUT OF STOCK, CONVEYED NON-VISUALLY. `product.js` toggles
                              `hidden` and adds a pulse animation — colour, opacity and
                              motion, none of which reach a screen reader. `role="status"`
                              makes the same class toggle an announcement, and it is on a
                              wrapper that is always in the DOM because a live region
                              inserted at the moment it fills is not reliably read.
                            #}
                            <div role="status">
                                <div data-testid="store-product-out-of-stock" class="out-of-stock min-h-7 leading-7 hidden text-base font-bold">{{ trans('pages.products.out_of_stock')}}</div>
                            </div>
                        </div>
                    </section>
                    {# Pre-order Campaign #}
                    {% if product.has_preorder_campaign %}
                        <section class="mt-5 p-5">
                            <salla-count-down data-testid="store-product-preorder-countdown" pre-order='{{ product.preorder|json_encode}}' boxed labeled></salla-count-down>
                        </section>
                    {% endif %}

                    <section class="sticky-product-bar bg-white p-5 rounded-md rounded-b-none">
                        {# Quantity #}
                        {% if product.is_hidden_quantity or product.type == 'booking' %}
                            <input type="hidden" value="1" name="quantity" aria-label="Quantity"/>
                        {% else %}
                            <div class="sticky-product-bar__quantity center-between mb-5">
                                <label class="form-label font-bold">
                                    {{ trans('pages.products.quantity') }}
                                </label>
                                <salla-quantity-input data-testid="store-product-quantity" max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="Quantity"
                                  class="border-gray-200 flex justify-end"></salla-quantity-input>
                            </div>
                        {% endif %}
                        {#
                          T-4.11 — THE ACTION ROW: add-to-cart and the wishlist
                          heart side by side, which is where the artboard draws
                          them — `301×48 rx12` beside `47×47 rx11.5`, 12.5 apart.

                          The heart came out of the gallery to get here. Upstream
                          floats it over the main image; no artboard draws it
                          there, and both the PDP and the card put it next to the
                          buy action instead. It is the same control, the same
                          `btn--wishlist` class `wishlist.js` already syncs from
                          `salla.wishlist.event`, and the same `aria-pressed`
                          T-4.01 added — nothing about its behaviour moved, only
                          its position.
                        #}
                        {#
                          T-4.12 — `data-price` is what lets the price survive
                          the sticky bar. With `support-sticky-bar` set and a
                          mobile viewport, `salla-add-product-button` stops
                          honouring the markup it captured and rewrites its label
                          from `getLabel()` on every render — which destroys the
                          price span T-4.11 put inside it. The setting defaults
                          to on, so that is the default mobile behaviour, and the
                          artboard's bar shows the price. `product.js` puts it
                          back; this is where it reads the starting value from.
                        #}
                        <div class="product-actions" data-price="{{ product.price|money }}">
                        {# Add to cart #}
                        <salla-add-product-button
                                data-testid="store-product-add-to-cart"
                                {{product.can_quick_buy ? 'quick-buy' : ''}}
                                {{theme.settings.get('sticky_add_to_cart') ? ' support-sticky-bar' : ''}}
                                {{product.is_require_shipping ? 'required-shipping' : ''}}
                                {{product.has_preorder_campaign ? 'has-pre-order' : ''}}
                                amount="{{ product.base_currency_price }}"
                                class="mt-5 w-full sticky-product-bar__btn"
                                product-status="{{ product.status }}"
                                product-type="{{ product.type }}"
                                product-id="{{ product.id }}"
                                loader-position="end"
                                type="submit"
                                width="wide"
                                {# Notify availability props#}
                                {% if product.notify_availability %}
                                    {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
                                    channels="{{ product.notify_availability.channels|join(',') }}"
                                    subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}"
                                    {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
                                {% endif %}>

                            {#
                              The price rides inside the button, as the artboard
                              draws it. It carries `total-price`, which is the
                              class `product.js` already rewrites on
                              `onPriceUpdated` — so choosing a variant updates the
                              button's price with no second binding to keep in
                              step, and it sits inside the T-4.10 live region's
                              sibling rather than duplicating the announcement.
                            #}
                            <span class="product-actions__price total-price" aria-hidden="true">{{ product.price|money }}</span>
                            <span>{{ product.add_to_cart_label }}</span>
                        </salla-add-product-button>

                        <salla-button
                                class="btn--wishlist product-actions__wishlist animated sws"
                                data-id="{{ product.id }}"
                                onclick="salla.wishlist.toggle('{{ product.id }}')"
                                aria-pressed="false"
                                data-label-add="{{ trans('theme.product.add_to_wishlist') }}"
                                data-label-remove="{{ trans('theme.product.remove_from_wishlist') }}"
                                aria-label="{{ trans('theme.product.add_to_wishlist') }}"
                                shape="icon"
                                fill="outline"
                                color="light">
                            <i class="sicon-heart" aria-hidden="true"></i>
                        </salla-button>
                        </div>
                    </section>
                    {% if product.is_giftable %}
                        <salla-gifting data-testid="store-product-gifting" class="mt-5" widget-subtitle="{{ gifting_intro }}" product-id="{{ product.id }}" {{ product.is_require_shipping ? 'physical-products' : ''  }}></salla-gifting>
                    {% endif %}
                </form>

                {% hook 'product:single.description.end' %}
                <salla-quick-order data-testid="store-product-quick-order" class="mt-5 md:-mb-2 block"></salla-quick-order>
            </div>
        </div>
        <salla-offer data-testid="store-product-offer"></salla-offer>
    </div>
    </div>{# /.product-details-panel — opened above the details container, T-4.09 #}

    {#
        Hook: product.single.before_customer_reviews
        Fires before the customer reviews/comments section.
        Use this hook to inject content between the product info and the reviews block.
    #}
    <div class="s-blocks-wrapper s-before-reviews">{% hook 'product.single.before_customer_reviews' %}</div>

    {# Comments Area #}
    {% if store.settings.rating.show_on_product %}
        <salla-comments data-testid="store-product-comments" item-id="{{product.id}}" type="product"></salla-comments>
    {% endif %}

    {#
        Hook: product.single.before_product_recommendations
        Fires before the similar/related products slider.
        Use this hook to inject content between the reviews and the recommendations section.
    #}
    <div class="s-blocks-wrapper s-before-related">{% hook 'product.single.before_product_recommendations' %}</div>

    {#
        T-4.14 — Similar Products Area.

        THE SLIDER IS NOT RENDERED HERE, AND THAT IS THE TASK. Doc 11 asks for
        this block to load below the fold, and `salla-products-slider` cannot be
        made to: it fetches in `componentWillLoad`, so the request goes out with
        the page whether or not anybody scrolls this far — and then
        `componentDidRender` **strips `loading="lazy"` off every image it
        rendered**, on an interval, ten times over. Read in its source. So the
        one block furthest below the fold was the most eager thing on the page.

        The element is therefore created by `product.js` when this container
        comes near the viewport. Deferring the *element* is the only lever that
        works, because both problems live inside its own lifecycle.

        `data-related-limit` is the merchant's, through `related_products_count`.
        Omitted rather than guessed when unset, so the platform's own default
        stands — a hard-coded 12 here would be this theme overruling a store
        setting it does not own.
    #}
    <div class="container mb-5 sm:mb-8">
        <div data-related-slider
             data-related-id="{{ product.id }}"
             data-related-title="{{ trans('pages.products.similar_products') }}"
             {% if theme.settings.get('related_products_count') %}data-related-limit="{{ theme.settings.get('related_products_count') }}"{% endif %}></div>
    </div>
    
    {#
        Hook: product.single.after_product_recommendations
        Fires after the similar/related products slider, at the very end of the product page content.
        Use this hook to append content below the recommendations section.
    #}
    <div class="s-blocks-wrapper s-after-related">{% hook 'product.single.after_product_recommendations' %}</div>
{% endblock %}

{% block scripts %}
    {# T-8.03 — the shared media bundle (`fslightbox`, `lite-youtube-embed`).
       It must precede the page bundle: both are `defer`, which executes in
       document order, and the page bundle imports from it. It was 41 KB
       shipped twice before this split. #}
    <script defer src="{{ 'media.js' | asset }}"></script>
    <script defer src="{{ 'product.js' | asset }}"></script>
    {% if product.has_3d_image %}
        <script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    {% endif %}
    {% if product.digital_files_settings %}
        <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}