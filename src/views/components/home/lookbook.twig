{#
  T-4.06b — the shoppable lookbook section on Home.

  This template is almost nothing, and that is the point. Everything that makes a
  hotspot work lives in `components.ui.hotspot-image`, because the owner's B6
  ruling says one component serves T-4.06 and T-7.07 and a second implementation
  is a defect. This registers the section, hands the merchant's settings over, and
  stops.

  | Variable                  | Type    | Description                              |
  |---------------------------|---------|------------------------------------------|
  | component.image           | string  | The editorial photograph                 |
  | component.alt             | ?string | Empty means decorative                   |
  | component.caption         | ?string | Tilted label over the image, mobile only |
  | component.layout          | string  | `overlay` or `list`                      |
  | component.hotspots[].x    | int     | 0–100, a PERCENTAGE                      |
  | component.hotspots[].y    | int     | 0–100, a PERCENTAGE                      |
  | component.hotspots[].product_id | string | Resolved at runtime, never stored   |
  | position                  | int     | Sorting number, from zero                |

  ONE SECTION IS ONE IMAGE, AND THE MERCHANT ADDS IT TWICE. The artboard shows
  two shoppable blocks on Home with different layouts, so the alternative shape —
  a collection of images each holding a collection of points — would need a
  nested collection, which the manifest schema does not support. One image per
  section is simpler for the merchant and needs no feature the platform lacks.
#}
{# The dropdown's value may be the option's value, the option, or a list of
   options — take the value in every case. #}
{% set lookbook_layout = component.layout|default('overlay') %}
{% if lookbook_layout.value is defined %}
    {% set lookbook_layout = lookbook_layout.value %}
{% elseif lookbook_layout is iterable %}
    {% set lookbook_layout = lookbook_layout|first %}
    {% if lookbook_layout.value is defined %}
        {% set lookbook_layout = lookbook_layout.value %}
    {% endif %}
{% endif %}
{# Which side the photograph takes on desktop (Desktop artboards, 2026-10-14):
   the two lookbook-style blocks on desktop Home alternate. Same dropdown
   resolution as `layout` above. #}
{% set lookbook_side = component.desktop_side|default('right') %}
{% if lookbook_side.value is defined %}
    {% set lookbook_side = lookbook_side.value %}
{% elseif lookbook_side is iterable %}
    {% set lookbook_side = lookbook_side|first %}
    {% if lookbook_side.value is defined %}
        {% set lookbook_side = lookbook_side.value %}
    {% endif %}
{% endif %}
{#
  Where else this image shows (public-theme pass, 2026-10-19;
  partials/lookbook-elsewhere.js): its products' pages as «نسّقيه مع», and a
  chosen category's page as its interactive cover. The product ids and the
  category id ride on the section for that script; a section hidden from Home
  is still rendered, inside a `<template>`, so the other pages can find it
  while Home neither shows it nor loads its images.
#}
{% set lookbook_product_ids = [] %}
{% for point in component.hotspots|default([]) %}
    {% set point_product = point.product is defined and point.product ? point.product : null %}
    {% if point_product is iterable and point_product.id is not defined %}
        {% set point_product = point_product|first %}
    {% endif %}
    {% if point_product %}
        {% set lookbook_product_ids = lookbook_product_ids|merge([point_product.id is defined ? point_product.id : point_product]) %}
    {% endif %}
{% endfor %}
{% set lookbook_category = component.category|default(null) %}
{% if lookbook_category is iterable and lookbook_category.id is not defined and lookbook_category.value is not defined %}
    {% set lookbook_category = lookbook_category|first %}
{% endif %}
{% set lookbook_category_id = '' %}
{% set lookbook_category_name = '' %}
{% if lookbook_category %}
    {% if lookbook_category.id is defined %}
        {% set lookbook_category_id = lookbook_category.id %}
    {% elseif lookbook_category.value is defined %}
        {% set lookbook_category_id = lookbook_category.value %}
    {% elseif lookbook_category is not iterable %}
        {% set lookbook_category_id = lookbook_category %}
    {% endif %}
    {% set lookbook_category_name = lookbook_category.name is defined ? lookbook_category.name : (lookbook_category.label is defined ? lookbook_category.label : '') %}
{% endif %}
{% set lookbook_hidden = component.hide_on_home|default(false) %}
{% if component.image and component.hotspots|length %}
    {% if lookbook_hidden %}<template data-lookbook-store>{% endif %}
    {# T-2.18 — panelled in the LIST layout and bare in OVERLAY, which is what the
       artboards draw: the list block stacks pills under its image and sits in a
       panel; the overlay block is a single edge-to-edge photograph and does not.
       The list panel is FLUSH: the mobile artboard runs the photograph and the
       rules between the product rows to the panel's edges (`M16 3250…V3582
       H16`, rules x16–x377). From 768px the panel comes off — the desktop
       artboard stands the photograph bare beside the warm product column
       (hotspot.scss). #}
    <section data-testid="store-home-lookbook"
             class="s-block lookbook container{{ lookbook_side == 'left' ? ' lookbook--image-left' : '' }}"
             data-lookbook
             data-lookbook-pdp="{{ component.show_on_products|default(true) ? 'true' : 'false' }}"
             data-lookbook-products="{{ lookbook_product_ids|join(',') }}"
             data-lookbook-category="{{ lookbook_category_id }}"
             data-lookbook-category-name="{{ lookbook_category_name|striptags|trim }}"
             data-lookbook-category-raw="{{ component.category is defined ? component.category|json_encode : 'undefined' }}">
        <div class="{{ lookbook_layout == 'list' ? 's-block__panel s-block__panel--flush' : '' }}">
            {% include 'components.ui.hotspot-image' with {
                image:     component.image,
                alt:       component.alt,
                caption:   component.caption,
                layout:    lookbook_layout,
                hotspots:  component.hotspots,
                id:        'lookbook-' ~ position,
                indicator: true
            } %}
        </div>
    </section>
    {% if lookbook_hidden %}</template>{% endif %}
{% endif %}
