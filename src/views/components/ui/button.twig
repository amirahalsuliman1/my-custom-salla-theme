{#
  T-2.05 — the theme's button.

  Usage:
    {% include 'components.ui.button' with { label: 'أضف للسلة'|trans } %}
    {% include 'components.ui.button' with { label: '…', variant: 'secondary', icon: 'shopping-bag' } %}
    {% include 'components.ui.button' with { variant: 'icon', icon: 'heart', label: 'أضف للمفضلة'|trans } %}
    {% include 'components.ui.button' with { label: '…', href: '/x' } %}

  Parameters:
    label     required — the accessible name, and the visible text unless
              variant is 'icon'. Pass it through |trans; never a literal.
    variant   primary (default) · secondary · neutral · ghost · icon · success
              · error. These map onto upstream's existing .btn-- classes where
              one exists; see 04-components/buttons.scss for the mapping and why.
    icon      sicon glyph name, without the prefix
    href      renders an <a> instead of a <button>
    type      button (default) · submit
    loading   true → aria-busy, non-interactive, and announced
    disabled  true
    class     extra utility classes
    attrs     map of extra attributes — { 'data-sheet-close': '' }. Added in
              T-2.11 so a caller can hang a hook on a button without forking the
              partial. Names are written literally and values are escaped, so
              nothing here can carry markup into the page.

  WHY A PARTIAL AND NOT JUST A CLASS. Three of the acceptance criteria cannot be
  met by a stylesheet: an icon-only button needs an accessible name, a loading
  button needs to announce itself, and a disabled button needs to stay
  announceable rather than vanishing from the accessibility tree. Each is
  forgettable at every call site. Routing buttons through here means the markup
  is right by default and wrong only on purpose.

  ON `disabled`: this emits `aria-disabled` plus a pointer-events lock rather
  than the `disabled` attribute. A natively disabled button is skipped by
  keyboard navigation entirely, so a user tabbing through a form never learns
  the submit button is there — they just run out of controls. `aria-disabled`
  keeps it reachable and announced as unavailable, which is what the design's
  disabled state actually means.

  ON `loading`: `aria-busy` marks the region, and the visually-hidden live
  region is what a screen reader actually announces — `aria-busy` alone is
  passive and many readers say nothing at all. The label stays visible so the
  button does not resize mid-action and shift the layout around it.
#}
{% set btn_variant = variant|default('primary') %}
{# Doc 04 forbids duplicated variants, so the design's names resolve to
   upstream's classes rather than to a parallel set of our own. #}
{% set btn_class_map = {
    'primary':   'btn--primary',
    'secondary': 'btn--outline-primary',
    'neutral':   'btn--neutral',
    'ghost':     'btn--ghost',
    'icon':      'btn--icon',
    'success':   'btn--success',
    'error':     'btn--danger'
} %}
{% set btn_class = btn_class_map[btn_variant]|default('btn--primary') %}
{% set btn_tag = href is defined and href is not empty ? 'a' : 'button' %}
{% set btn_busy = loading|default(false) %}
{% set btn_off = disabled|default(false) %}

<{{ btn_tag }}
  class="btn {{ btn_class }} {{ class|default('') }}"
  {% if btn_tag == 'a' %}href="{{ href }}"{% else %}type="{{ type|default('button') }}"{% endif %}
  {% if btn_variant == 'icon' %}aria-label="{{ label }}"{% endif %}
  {% if btn_busy %}aria-busy="true"{% endif %}
  {% if btn_off %}aria-disabled="true"{% if btn_tag == 'a' %} role="link" tabindex="-1"{% endif %}{% endif %}
  {% for attr_name, attr_value in attrs|default({}) %} {{ attr_name }}="{{ attr_value }}"{% endfor %}
>
  {% if icon is defined and icon is not empty %}
    {% include 'components.ui.icon' with { name: icon, size: btn_variant == 'icon' ? 'lg' : 'md' } only %}
  {% endif %}

  {% if btn_variant != 'icon' %}
    <span class="btn__label">{{ label }}</span>
  {% endif %}

  {% if btn_busy %}
    <span class="sr-only" role="status">{{ 'theme.common.loading'|trans }}</span>
  {% endif %}
</{{ btn_tag }}>
