{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
<header data-testid="store-header" class="store-header">

  {# Top Announcement Bar (marquee) #}
  {# temporarily disabled #}

  {# Main Header #}
  <div id="mainnav" class="main-nav-container flex items-center">
    <div class="inner w-full">
      <div class="container">
        <div class="flex items-center justify-between">

          {# Left group: user menu + cart #}
          <div class="flex items-center gap-3">
            <salla-user-menu data-testid="store-header-user-menu"
                              avatar-only
                              show-trigger></salla-user-menu>

            <salla-cart-summary data-testid="store-header-cart">
              <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
            </salla-cart-summary>
          </div>

          {# Center: logo #}
          <a data-testid="store-header-logo" class="navbar-brand" href="{{ store.url }}">
            <img fetchpriority="high"
                 width="100%" height="100%"
                 loading="eager"
                 src="{{ store.logo|cdn(175) }}"
                 alt="{{ store.name }} logo">
            {% if is_page('index') %}
              <h1 class="sr-only">{{ store.name }}</h1>
            {% else %}
              <h2 class="sr-only">{{ store.name }}</h2>
            {% endif %}
          </a>

          {# Right group: search + mobile menu toggle #}
          <div class="flex items-center gap-3">
            <button data-testid="store-header-search-trigger"
                    class="header-btn"
                    onclick="salla.event.dispatch('search::open')">
              <i class="header-btn__icon icon sicon-magnifier"></i>
            </button>

            <a data-testid="store-header-mobile-toggle"
               class="mburger mburger--collapse leading-none header-btn"
               href="#mobile-menu"
               aria-label="Open menu">
              <i class="header-btn__icon icon sicon-menu"></i>
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>

</header>