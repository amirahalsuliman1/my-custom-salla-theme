    "prod": "webpack --mode production",
    "development": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "lint": "pnpm run lint:css && pnpm run lint:js && pnpm run lint:locales",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:js": "eslint --max-warnings 0 .",
    "lint:locales": "node scripts/check-locales.mjs",
    "lint:format": "prettier --check .",
    "lint:changed": "node scripts/lint-changed.mjs",
    "check:budgets": "node scripts/check-budgets.mjs"
  },
  "author": "Salla",
  "dependencies": {
