    "type": "git",
    "url": "git+https://github.com/SallaApp/theme-raed.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "test": "echo \"Error: no test specified\" && exit 1",
